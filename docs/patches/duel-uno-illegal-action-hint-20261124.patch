+    def test_illegal_play_echoes_move_and_only_suggests_close_legal_action(self):
+        state = self.scenario({
+            "player-1": ["red-draw_two-2", "red-draw_two-1"],
+            "player-2": ["blue-number-5-1"],
+        }, "red-number-5-1")
+        before = deepcopy(state)
+        for card_id, suggestion in (
+            ("red-draw-two-1", {"action": "play", "card_id": "red-draw_two-1", "uno": True}),
+            ("blue-number-5-1", None),
+        ):
+            with self.subTest(card_id=card_id):
+                move = {"action": "play", "card_id": card_id, "uno": True}
+                with self.assertRaises(ValueError) as error:
+                    self.game.apply_action(state, move, self.actor(0))
+                message = str(error.exception)
+                self.assertIn(json.dumps(move), message)
+                if suggestion is None:
+                    self.assertNotIn("最接近", message)
+                else:
+                    self.assertIn(json.dumps(suggestion), message)
+                self.assertEqual(state, before)
+
