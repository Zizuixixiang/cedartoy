diff --git a/app/games/uno.py b/app/games/uno.py
index 6aa7aa4..63626be 100644
--- a/app/games/uno.py
+++ b/app/games/uno.py
@@ -1,7 +1,9 @@
 from __future__ import annotations
 
+import json
 import random
 from copy import deepcopy
+from difflib import SequenceMatcher
 from typing import Any
 
 from .base import GamePlugin, MoveResult
@@ -334,8 +336,36 @@ class Uno(GamePlugin):
         if not isinstance(move, dict):
             raise ValueError("move 必须是对象")
         player_id = str(actor["player_id"])
-        if move not in self._legal_actions_for(state, player_id):
-            raise ValueError("该动作不在服务端权威 legal_actions 中")
+        legal = self._legal_actions_for(state, player_id)
+        if move not in legal:
+            message = f"该动作不在服务端权威 legal_actions 中。提交动作：{json.dumps(move, ensure_ascii=False)}"
+            closest = self._closest_legal_action(move, legal)
+            if closest is not None:
+                message += f"。最接近的当前合法动作：{json.dumps(closest, ensure_ascii=False)}"
+            raise ValueError(message)
+
+    @staticmethod
+    def _closest_legal_action(
+        move: dict[str, Any], legal: list[dict[str, Any]]
+    ) -> dict[str, Any] | None:
+        closest = None
+        best_score = 0.0
+        for candidate in legal:
+            if move.keys() != candidate.keys():
+                continue
+            score = 1.0
+            for key, value in candidate.items():
+                submitted = move[key]
+                if submitted == value:
+                    continue
+                if not isinstance(submitted, str) or not isinstance(value, str):
+                    score = 0.0
+                    break
+                matcher = SequenceMatcher(None, submitted.replace("-", "_"), value.replace("-", "_"))
+                score = min(score, matcher.ratio())
+            if score >= 0.85 and score > best_score:
+                closest, best_score = candidate, score
+        return closest
 
     def validate_move(
         self, state: dict[str, Any], move: dict[str, Any], mark: str
