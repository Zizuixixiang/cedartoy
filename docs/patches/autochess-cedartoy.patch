+ useEffect(()=>{alive.current=true;void refresh();return()=>{alive.current=false;};},[]);
+ const run=async(op:string,params:object={})=>{
+  if(locked.current||!valid())return;
+  if(readOnly){setError("小机钱包仅供查看，请由小机自行操作");return;}
+  if(pending.current&&JSON.stringify([op,params])!==JSON.stringify([pending.current.op,pending.current.params])){setError('请先重试上一笔未确认操作。');return;}
