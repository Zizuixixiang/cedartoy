diff --git a/scripts/cedartoy-server.ts b/scripts/cedartoy-server.ts
new file mode 100644
index 0000000..0f8a25e
--- /dev/null
+++ b/scripts/cedartoy-server.ts
@@ -0,0 +1,124 @@
+/** Cedar-only satellite. Deliberately does not import the upstream HTTP/account/Cursor server. */
+import { createServer, type IncomingMessage, type ServerResponse } from 'node:http';
+import { isAbsolute } from 'node:path';
+import { CedarEconomy } from '../lib/accounts/cedartoy-economy';
+import {join} from 'node:path';
+import { RoomStore } from '../lib/autochess/room-store';
+import { PlatformRoomAdapter, platformIdentity, verifyPlatformSecret, decodePlatformDisplayName } from '../lib/autochess/platform-adapter';
+import { cedarWeb } from '../lib/autochess/cedartoy-web';
+
+export function cedarServer(store: RoomStore, secret: string, economy?:CedarEconomy) {
+  if (!/^[a-f0-9]{64}$/.test(secret)) throw Error('CHESS_PLATFORM_SECRET must be 32 random bytes encoded as lowercase hex');
+  const adapter = new PlatformRoomAdapter(store);
+  let active = 0;
+  const waiting = new Map<string, AbortController>();
+  const send = (res: ServerResponse, status: number, data: unknown) => {
+    if (res.destroyed) return;
+    res.writeHead(status, {'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'});
+    res.end(JSON.stringify(data));
+  };
+  const header = (req: IncomingMessage, name: string) => typeof req.headers[name] === 'string' ? req.headers[name] as string : '';
+  const server = createServer(async (req, res) => {
+    if (!['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(req.socket.remoteAddress ?? '') ||
+        req.headers.origin || req.headers.authorization || req.headers.cookie ||
+        !verifyPlatformSecret(secret, header(req, 'x-autochess-platform-secret'))) {
+      send(res,403,{error:'Forbidden'}); return;
+    }
+    if (req.method === 'GET' && req.url === '/health') { send(res,200,{ok:true,slim:!economy,economy:!!economy}); return; }
+    if (req.method !== 'POST' || !['/platform/autochess','/platform/web','/platform/stats','/platform/economy'].includes(req.url ?? '')) { send(res,404,{error:'Not found'}); return; }
+    if (active >= 128) { send(res,503,{error:'Busy'}); return; }
+    active++;
+    let waitKey = '';
+    let waitController: AbortController | undefined;
+    try {
+      if (!header(req,'content-type').startsWith('application/json')) { send(res,415,{error:'JSON required'}); return; }
+      const parts: Buffer[] = []; let size = 0;
+      for await (const part of req) {
+        size += part.length;
+        if (size > 65536) { send(res,413,{error:'Payload too large'}); return; }
+        parts.push(part);
+      }
+      const body = JSON.parse(Buffer.concat(parts).toString('utf8'));
+      const role=header(req,'x-player-type') || 'guest';
+      if(!['human','ai','guest'].includes(role)) throw Error('Invalid player type');
+      const identity = platformIdentity({playerId:header(req,'x-player-id'),provider:'cedartoy',
+        displayName:decodePlatformDisplayName(header(req,'x-player-name')),actorType:role as 'human'|'ai'|'guest'});
+      if(req.url==='/platform/stats') {
+        const windows:Record<string,number>={'10m':600,'1h':3600,'6h':21600,'12h':43200,'24h':86400,'7d':604800,'14d':1209600,'30d':2592000};
+        const period=body?.range;
+        if(period!=='all' && (!Object.hasOwn(windows,period)||!Number.isInteger(windows[period]))) throw Error('Invalid range');
+        if(body?.view!==undefined && body.view!=='breakdown') throw Error('Invalid stats view');
+        const now=Date.now(),since=period==='all'?0:now-windows[period]*1000;
+        const data=body?.view==='breakdown'?store.platformPlayBreakdown(since,now):store.platformStats(since,now);
+        send(res,200,{range:period,generated_at:new Date(now).toISOString(),...data});return;
+      }
+      if(req.url==='/platform/economy'||(req.url==='/platform/autochess'&&body?.action==='meta')) {
+        if(!economy)throw Error('旧精简模式未启用局外功能');
+        const params=req.url==='/platform/economy'?body:body.params;
+        send(res,200,economy.play(identity,body.context,params?.op,params?.params??params??{}));return;
+      }
+      if(economy) {
+        economy.sync(identity,body.context);
+        Object.assign(identity.owner,economy.appearance(identity.owner.accountId));
+      }
+      if(req.url==='/platform/web') {
+        if(role!=='human' && body?.op!=='state' && body?.op!=='config') throw Error('Human session required');
+        const household=(Array.isArray(body?.household)?body.household:[]).map((person:any)=>platformIdentity({playerId:person.playerId,displayName:person.name,actorType:'ai'}).owner);
+        if(economy)for(const person of household)Object.assign(person,economy.appearance(person.accountId));
+        send(res,200,await cedarWeb(store,identity,body?.op,body?.params??{},household,!!economy));return;
+      }
+      const roomId=body?.params?.roomId ?? body?.params?.room_id;
+      const key=`${identity.owner.accountId}:${roomId}`;
+      if(body?.action==='cancel_wait') {
+        await adapter.play(identity,'read',{roomId});
+        waiting.get(key)?.abort();send(res,200,{status:'wait_cancelled',roomId});return;
+      }
+      if(['act','start'].includes(body?.action)) waiting.get(key)?.abort();
+      if (body?.params?.waitMs || body?.params?.wait_ms) {
+        if(waiting.size>=96 && !waiting.has(key)) {send(res,429,{error:'Wait capacity reached'});return;}
+        waiting.get(key)?.abort();waitKey=key;waitController=new AbortController();waiting.set(key,waitController);
+      }
+      // No upstream credentials or canonical IDs are echoed. Raw headers are never logged.
+      const abort = waitController ?? new AbortController();
+      const disconnected = () => abort.abort();
+      res.once('close', disconnected);
+      let reply: unknown;
+      try { reply = await adapter.play(identity,body?.action,body?.params,abort.signal); }
+      finally { res.removeListener('close', disconnected); }
+      send(res,200,abort.signal.aborted ? {status:'wait_cancelled',roomId} : reply);
+    } catch (error) {
+      // Filesystem exceptions can contain private paths. Do not forward them to clients.
+      const code = (error as NodeJS.ErrnoException)?.code;
+      send(res,code ? 503 : 400,{error:code ? 'Room storage unavailable' : error instanceof Error ? error.message : 'Invalid request'});
+    } finally {
+      active--; if (waitKey && waiting.get(waitKey)===waitController) waiting.delete(waitKey);
+    }
+  });
+  server.requestTimeout = 10000;
+  server.headersTimeout = 10000;
+  // One timer per satellite listener, sharing its single RoomStore. No session ping
+  // writes and no request required for idle archival or terminal retention cleanup.
+  let maintenance: ReturnType<typeof setInterval> | undefined;
+  server.on('listening', () => {
+    if (maintenance) return;
+    maintenance = setInterval(() => {
+      try { store.cleanup(); }
+      catch { console.error('AutoChess room maintenance failed; retrying next interval'); }
+    }, 20 * 60 * 1000);
+    maintenance.unref();
+  });
+  server.on('close', () => { clearInterval(maintenance); maintenance = undefined; });
+  return server;
+}
+
+if (process.argv[1]?.endsWith('/cedartoy-server.ts')) {
+  const full=process.env.CHESS_CEDAR_MODE==='platform';
+  if (!full && (process.env.CHESS_SLIM ?? '1') !== '1') throw Error('Use CHESS_CEDAR_MODE=platform or legacy CHESS_SLIM=1');
+  const directory = process.env.CHESS_ROOM_DATA ?? '';
+  if (!isAbsolute(directory)) throw Error('CHESS_ROOM_DATA must be an absolute private data directory');
+  const port = Number(process.env.CHESS_ROOM_PORT ?? 8791);
+  if (!Number.isInteger(port) || port < 1024 || port > 65535) throw Error('Invalid CHESS_ROOM_PORT');
+  // The launcher holds an exclusive OS lock for this directory for the entire process lifetime.
+  const economy=full?new CedarEconomy(join(directory,'economy')):undefined;
+  cedarServer(new RoomStore(directory,economy,undefined,economy?(id=>economy.appearance(id)):undefined), process.env.CHESS_PLATFORM_SECRET ?? '',economy).listen(port,'127.0.0.1');
+}
