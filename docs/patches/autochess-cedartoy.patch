+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Readable } from 'node:stream';
+import { EventEmitter } from 'node:events';
+import { test } from 'node:test';
+import { cedarServer } from '../scripts/cedartoy-server';
+import { RoomStore } from '../lib/autochess/room-store';
+import { PlatformRoomAdapter, platformIdentity } from '../lib/autochess/platform-adapter';
+
+test('route handler is fail-closed without depending on UI or listening sockets', async t => {
+  const dir=mkdtempSync(join(tmpdir(),'autochess-routes-'));t.after(()=>rmSync(dir,{recursive:true,force:true}));
+  const server=cedarServer(new RoomStore(dir),'a'.repeat(64));
+  const handler=server.listeners('request')[0]!;
+  const headers={'x-autochess-platform-secret':'a'.repeat(64),'x-player-id':'42','content-type':'application/json'};
+  async function call(url:string, body:any={}, extra:Record<string,string>={}, address='127.0.0.1') {
+    const req=Readable.from([Buffer.from(JSON.stringify(body))]) as any;
+    Object.assign(req,{method:'POST',url,headers:{...headers,...extra},socket:{remoteAddress:address}});
+    const res=new EventEmitter() as any;
+    res.writeHead=(status:number)=>{res.status=status;};res.end=(raw:string)=>{res.body=JSON.parse(raw);};
+    await handler.call(server,req,res);
+    return res;
+  }
+  for(const url of ['/room','/account','/mcp','/player','/match','/feedback','/platform/autochess?x=1']) assert.equal((await call(url)).status,404);
+  for(const extra of <Record<string,string>[]>[{'x-autochess-platform-secret':'bad'},{origin:'https://toy.cedarstar.org'},{cookie:'session=x'},{authorization:'Bearer x'}]) assert.equal((await call('/platform/autochess',{},extra)).status,403);
+  assert.equal((await call('/platform/autochess',{}, {}, '203.0.113.1')).status,403);
+  assert.equal((await call('/platform/autochess',{big:'a'.repeat(65536)})).status,413);
+  const created=await call('/platform/autochess',{action:'create',params:{requestId:'route-create-1'}});
+  assert.equal(created.status,200);
+  assert.equal((await call('/platform/autochess',{action:'read',params:{roomId:created.body.roomId,player_id:'42'}},{'x-player-id':'43'})).status,400);
+  assert.equal((await call('/platform/autochess',{action:'login',params:{}})).status,400);
+});
+
+test('satellite wait yields to another request and disconnect cancels it', async t => {
+  const dir=mkdtempSync(join(tmpdir(),'autochess-wait-'));t.after(()=>rmSync(dir,{recursive:true,force:true}));
+  const adapter=new PlatformRoomAdapter(new RoomStore(dir));const host=platformIdentity({playerId:'42'});
+  const created:any=await adapter.play(host,'create',{requestId:'wait-create-1'});
+  const controller=new AbortController();const began=Date.now();
+  const pending=adapter.play(host,'read',{roomId:created.roomId,after:created.current.revision,waitMs:25000},controller.signal);
+  const read:any=await adapter.play(host,'read',{roomId:created.roomId});
+  assert.equal(read.phase,'waiting');
+  controller.abort();await pending;assert.ok(Date.now()-began<1000);
+});
