diff --git a/test/cedartoy-idle.test.ts b/test/cedartoy-idle.test.ts
new file mode 100644
index 0000000..acb4f72
--- /dev/null
+++ b/test/cedartoy-idle.test.ts
@@ -0,0 +1,88 @@
+import assert from 'node:assert/strict';
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { test } from 'node:test';
+import { RoomStore } from '../lib/autochess/room-store';
+
+test('private waiting/prepare rooms survive idle reads and a cold process; upstream idle rules remain', t => {
+  const directory = mkdtempSync(join(tmpdir(), 'cedar-idle-'));
+  t.after(() => rmSync(directory, { recursive: true, force: true }));
+  let settlements = 0;
+  const store = new RoomStore(directory, { settle() { settlements++; } });
+  const host = { accountId: 'test:idle-host', accountName: '临时棋手' };
+  const peer = { accountId: 'test:idle-peer', accountName: '临时棋友' };
+  const cases: { roomId: string; token: string; phase: string; private: boolean; travel?: boolean; hp?: number[] }[] = [];
+  for (const phase of ['waiting', 'prepare']) {
+    const room = store.createForPlatform(host, `idle-${phase}`, 'ai', 'duel', 2);
+    const credentials = store.accountSeat(room.roomId, host.accountId)!;
+    if (phase === 'prepare') store.start(credentials, 'idle-start');
+    cases.push({ ...credentials, phase, private: true });
+    const upstream = store.create('原版', 'ai', 2, host, 'duel');
+    if (phase === 'prepare') store.start(upstream, 'upstream-start');
+    cases.push({ ...upstream, phase, private: false });
+  }
+  const queue = store.createMatched('idle-queue', [host, peer], 'ai', 2);
+  cases.push({ roomId: queue.roomId, token: queue.seats[0]!.token, phase: 'prepare', private: false });
+  const travel = store.create('远游', 'ai', 2, host, 'duel', 'travel');
+  store.start(travel, 'travel-start');
+  cases.push({ ...travel, phase: 'prepare', private: false, travel: true });
+
+  // Age persisted snapshots, then exercise the still-running store with the same elapsed time.
+  for (const item of cases) {
+    const file = join(directory, item.roomId + '.json');
+    const raw = JSON.parse(readFileSync(file, 'utf8'));
+    item.hp = raw.seats.map((seat: { hp: number }) => seat.hp);
+    raw.updatedAt = Date.now() - 61 * 60_000;
+    writeFileSync(file, JSON.stringify(raw));
+  }
+  const now = Date.now;
+  Date.now = () => now() + 61 * 60_000;
+  try {
+    for (const item of cases.filter(item => item.private)) {
+      const view = store.view(item);
+      assert.equal(view.phase, item.phase);
+      assert.equal(view.self?.hp, item.hp![0]);
+      assert.equal(view.self?.result, undefined);
+    }
+    assert.equal(settlements, 0);
+  } finally { Date.now = now; }
+
+  const code = `
+    import assert from 'node:assert/strict';
+    import {readFileSync} from 'node:fs';
+    import {join} from 'node:path';
+    import {RoomStore} from './lib/autochess/room-store.ts';
+    const directory=process.env.IDLE_DIRECTORY;
+    const cases=JSON.parse(process.env.IDLE_CASES);
+    const settled=[];
+    const store=new RoomStore(directory,{settle(input){settled.push(input);}});
+    for(const item of cases){
+      const view=store.view(item);
+      const raw=JSON.parse(readFileSync(join(directory,item.roomId+'.json'),'utf8'));
+      assert.equal(view.phase,item.private?item.phase:'finished');
+      assert.equal(raw.finishReason,item.private?undefined:'idle');
+      if(item.private){
+        assert.equal(raw.settled,undefined);
+        assert.equal(raw.platformTimes.finished,undefined);
+        assert(raw.seats.every(seat=>!seat.result));
+        assert.deepEqual(raw.seats.map(seat=>seat.hp),item.hp);
+        assert(!settled.some(input=>input.roomId===item.roomId));
+      }else{assert.equal(raw.winner,item.travel?1:'draw');}
+    }
+    assert(settled.some(input=>input.travelIdleLoss));
+    // Explicit cancellation and resignation still end private rooms after reconnection.
+    for(const item of cases.filter(item=>item.private)){
+      const view=store.view(item);
+      const result=store.mutate({...item,round:view.round,revision:view.self.revision,
+        requestId:'explicit-end',action:{kind:item.phase==='waiting'?'cancel_room':'resign'}});
+      assert.equal(result.phase,'finished');
+    }
+  `;
+  const child = spawnSync(process.execPath, ['--import', 'tsx', '--input-type=module', '-e', code], {
+    cwd: new URL('..', import.meta.url), encoding: 'utf8', timeout: 30_000,
+    env: { ...process.env, IDLE_DIRECTORY: directory, IDLE_CASES: JSON.stringify(cases) },
+  });
+  assert.equal(child.status, 0, child.stderr || child.stdout);
+});
