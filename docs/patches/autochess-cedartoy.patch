+import type {RoomView} from '../../lib/autochess/room-types';
+
+export function waitingStartHint(host:boolean,hasEmptySeats=true){
+ return host?(hasEmptySeats?'你是房主，请先点「补路人机，直接开局」；也可先邀请好友入座。':'你是房主，请先点「开始棋局」。'):'请等待房主开始；开局后再选择装备或操作棋子。';
+}
+/** Only preparation exposes game mutations. A waiting seat already has offers in
+ * its snapshot, but these are not actionable until the host explicitly starts. */
+export function roomPreparationUI(view:Pick<RoomView,'phase'|'self'>,playback:boolean,busy:boolean){
+ const preparing=view.phase==='prepare'&&!!view.self&&view.self.hp>0&&!view.self.result&&!playback;
+ return {editable:preparing&&!view.self!.ready&&!busy,offers:preparing,shop:preparing};
+}
diff --git a/lib/accounts/cedartoy-economy.ts b/lib/accounts/cedartoy-economy.ts
new file mode 100644
index 0000000..665ce11
--- /dev/null
+++ b/lib/accounts/cedartoy-economy.ts
@@ -0,0 +1,116 @@
+/** Local-only wallet bridge: upstream rules, one SQLite transaction per operation. */
+import {DatabaseSync} from 'node:sqlite';
+import {mkdirSync,chmodSync} from 'node:fs';
+import {join} from 'node:path';
+import {createHash} from 'node:crypto';
+import {AccountStore,type AccountFile,type MatchSettlementInput} from './account-store';
+import {platformIdentity,type PlatformIdentity} from '../autochess/platform-adapter';
+import {listedCosmetics,DEFAULT_BOARD_SKIN} from '../meta/cosmetics';
+import {CURRENCY,EXCHANGE_BOT_PER_HUMAN,MATCH_REWARD} from '../meta/economy';
+
+type Person={playerId:string;name:string;actorType:'human'|'ai';owners?:string[]};
+const fail=(message:string):never=>{throw Error(message);};
+function readState(body:string):AccountFile {
+  try {
+    const data=JSON.parse(body);
+    if(data?.version!==1||!Array.isArray(data.accounts)||data.accounts.some((a:any)=>
+      !a||!/^platform:cedartoy:[a-f0-9]{32}$/.test(a.id)||typeof a.isAi!=='boolean'||
+      !['human','bot'].every(c=>Number.isSafeInteger(a.coins?.[c]))))throw Error();
+    if(new Set(data.accounts.map((a:any)=>a.id)).size!==data.accounts.length)throw Error();
+    return data;
+  }catch {throw Object.assign(Error('Wallet storage unavailable'),{code:'CEDAR_WALLET_INVALID'});}
+}
+export class CedarEconomy {
+  readonly db:DatabaseSync;
+  constructor(directory:string) {
+    mkdirSync(directory,{recursive:true,mode:0o700});
+    const file=join(directory,'accounts.db');this.db=new DatabaseSync(file);chmodSync(file,0o600);
+    this.db.exec(`PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA busy_timeout=5000;
+      CREATE TABLE IF NOT EXISTS state(id INTEGER PRIMARY KEY CHECK(id=1), body TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS receipts(actor TEXT NOT NULL, request TEXT NOT NULL, fingerprint TEXT NOT NULL, response TEXT NOT NULL, PRIMARY KEY(actor,request));`);
+    const existing=this.db.prepare('SELECT body FROM state WHERE id=1').get() as {body:string}|undefined;
+    try {if(existing)readState(existing.body);}catch(error){this.db.close();throw error;}
+  }
+  close(){this.db.close();}
+  private transaction<T>(run:(store:AccountStore)=>T):T {
+    this.db.exec('BEGIN IMMEDIATE');
+    try {
+      const row=this.db.prepare('SELECT body FROM state WHERE id=1').get() as {body:string}|undefined;
+      let staged:AccountFile|undefined;
+      const store=new AccountStore('',undefined,{enabled:true},{read:()=>row?readState(row.body):undefined,write:data=>{staged=data;}});
+      const result=run(store);
+      if(staged&&JSON.stringify(staged)!==row?.body)this.db.prepare('INSERT INTO state VALUES(1,?) ON CONFLICT(id) DO UPDATE SET body=excluded.body').run(JSON.stringify(staged));
+      this.db.exec('COMMIT');return result;
+    }catch(error){this.db.exec('ROLLBACK');throw error;}
+  }
+  private people(identity:PlatformIdentity,context:unknown) {
+    if(identity.owner.actorType==='guest'||identity.playerId.startsWith('guest:'))fail('游客不提供局外钱包');
+    if(!Array.isArray(context)||context.length>200)fail('需要平台账号上下文');
+    const slot=identity.playerId.split(':')[1]??'1';
+    if(!(context as Person[]).some(p=>p.playerId===identity.playerId&&p.actorType===identity.owner.actorType))fail('平台身份类型不匹配');
+    return (context as Person[]).map(p=>{
+      if(!/^[1-9][0-9]*(?::[2-5])?$/.test(p.playerId)||(p.playerId.split(':')[1]??'1')!==slot||!['human','ai'].includes(p.actorType))fail('平台账号或存档槽无效');
+      const owner=platformIdentity({playerId:p.playerId,displayName:p.name,actorType:p.actorType}).owner;
+      return {id:owner.accountId,name:owner.accountName,isAi:p.actorType==='ai',owners:p.owners?.map(id=>{
+        if(!/^[1-9][0-9]*(?::[2-5])?$/.test(id)||(id.split(':')[1]??'1')!==slot)fail('绑定存档槽不匹配');
+        return platformIdentity({playerId:id}).owner.accountId;
+      })};
+    });
+  }
+  sync(identity:PlatformIdentity,context:unknown) {
+    if(identity.owner.actorType==='guest')return;
+    const people=this.people(identity,context);
+    this.transaction(store=>store.platformRun(people,identity.owner.accountId,()=>undefined));
+  }
+  appearance(accountId:string) {
+    const row=this.db.prepare('SELECT body FROM state WHERE id=1').get() as {body:string}|undefined;
+    const account:AccountFile['accounts'][number]|undefined=row?readState(row.body).accounts.find(a=>a.id===accountId):undefined;
+    return account?{skinId:account.cosmetics?.equipped.board??DEFAULT_BOARD_SKIN,frame:account.cosmetics?.equipped.frame}:undefined;
+  }
+  settle(input:MatchSettlementInput){return this.transaction(store=>{
+    // A pre-upgrade room may contain a player who has not authenticated since
+    // wallets were enabled. Keep payment pending until their trusted identity arrives.
+    if(input.entries.some(entry=>!store.getAccount(entry.accountId)))fail('等待平台账号初始化钱包');
+    return store.settleMatch(input);
+  });}
+  play(identity:PlatformIdentity,context:unknown,op:unknown,p:Record<string,any>) {
+    const people=this.people(identity,context),actor=people.find(p=>p.id===identity.owner.accountId)??fail('平台身份不匹配');
+    const peers=actor.isAi?people.filter(p=>actor.owners?.length===1&&actor.owners[0]===p.id):people.filter(p=>p.isAi&&p.owners?.length===1&&p.owners[0]===actor.id);
+    // The original wheel allows arbitrary username lookup. Cedar limits recipients to live household bindings.
+    let target:string|undefined;
+    if(op==='gift')target=actor.isAi&&peers.length===1?peers[0]!.id:fail('只能由归属明确的小机送给自己的人');
+    if(op==='subsidize'||(op==='wheel_action'&&p.command?.action==='gift')) {
+      const to=op==='subsidize'?p.to:p.command.to;
+      const found=actor.isAi?peers:peers.filter(peer=>to===peer.id||to===peer.name||to===(context as Person[]).find(person=>platformIdentity({playerId:person.playerId}).owner.accountId===peer.id)?.playerId);
+      if(found.length!==1)fail('收礼人必须是当前唯一绑定的家人');
+      target=found[0]!.id;
+      if(actor.isAi&&to&&to!==target&&to!==found[0]!.name)fail('收礼人固定为当前绑定人类');
+    }
+    const reads=['profile','catalog','wheel'];
+    if(![...reads,'buy','equip','gift','claim','subsidize','wheel_action'].includes(String(op)))fail('未知局外操作');
+    const requestId=op==='wheel_action'?p.command?.requestId:p.requestId;
+    if(!reads.includes(String(op))&&(typeof requestId!=='string'||!/^[a-zA-Z0-9_-]{8,80}$/.test(requestId)))fail('需要有效 requestId');
+    const fingerprint=createHash('sha256').update(JSON.stringify([op,p,target])).digest('hex');
+    return this.transaction(store=>store.platformRun(people,actor.id,token=>{
+      if(!reads.includes(String(op))) {
+        const old=this.db.prepare('SELECT fingerprint,response FROM receipts WHERE actor=? AND request=?').get(actor.id,requestId) as {fingerprint:string;response:string}|undefined;
+        if(old){if(old.fingerprint!==fingerprint)fail('重试编号已用于另一操作或收礼人已变化');return JSON.parse(old.response);}
+      }
+      let result:unknown;
+      switch(op) {
+        case 'catalog':result={cosmetics:listedCosmetics(),currencies:CURRENCY,exchange:EXCHANGE_BOT_PER_HUMAN,reward:MATCH_REWARD,defaultSkin:DEFAULT_BOARD_SKIN,wheelEnabled:true};break;
+        case 'profile':result={self:store.selfAccount(token),recipients:peers.map(p=>({id:p.id,username:p.name}))};break;
+        case 'buy':result={self:store.buyCosmetic(token,p.cosmeticId)};break;
+        case 'equip':result={self:store.equipCosmetic(token,p.cosmeticId)};break;
+        case 'claim':result=store.claimGifts(token,p.giftId);break;
+        case 'gift':result=store.giftCosmeticForAccount(token,requestId,p.cosmeticId,p.note);break;
+        case 'subsidize':result=store.subsidize(token,target,p.coins,requestId);break;
+        case 'wheel':result=store.wheelView(token);break;
+        case 'wheel_action':result=store.wheelAction(token,{...p.command,...(target?{to:target}:{})});break;
+      }
+      if((op==='wheel'||op==='wheel_action')&&result){const view=result as any;delete view.guide;view.recipientHint='仅限当前绑定的家人';view.gifting.recipients=peers.filter(p=>p.isAi).map(p=>({id:p.id,username:p.name}));}
+      if(!reads.includes(String(op)))this.db.prepare('INSERT INTO receipts VALUES(?,?,?,?)').run(actor.id,requestId,fingerprint,JSON.stringify(result));
+      return result;
+    }));
+  }
+}
diff --git a/lib/autochess/cedartoy-web.ts b/lib/autochess/cedartoy-web.ts
new file mode 100644
index 0000000..4001d6a
--- /dev/null
+++ b/lib/autochess/cedartoy-web.ts
@@ -0,0 +1,55 @@
+import { type PlatformIdentity } from './platform-adapter';
+import type { RoomStore, SeatOwner } from './room-store';
+import type { RoomAction } from './room-types';
+import { PACK_SUMMARIES } from '../../packs/registry';
+import { LOBBY_MODES } from '../../packs/modes/registry';
+
+const fail=(message:string):never=>{throw Error(message);};
+const clean=(value:unknown):any=>Array.isArray(value)?value.map(clean):value&&typeof value==='object'?
+  Object.fromEntries(Object.entries(value).filter(([key])=>!['token','watchToken','accountId','actorKey','actorType','activeAt','accountName'].includes(key)).map(([key,v])=>[key,clean(v)])):value;
+const text=(value:unknown)=>typeof value==='string'?value:fail('参数必须是文字');
+function action(raw:unknown):RoomAction {
+  if(!raw||typeof raw!=='object'||Array.isArray(raw)) fail('无效操作');
+  const a=raw as Record<string,unknown>;
+  const spec:Record<string,string[]>={buy:['index'],sell:['piece'],move:['piece','row','col'],withdraw:['piece'],equip:['piece','item'],unequip:['piece','item'],consume:['piece','item'],pick_hex:['hex'],pick_item:['item'],pick_sword:['item'],buy_xp:['times'],refresh:[],ready:[],unready:[],roll:[],claim:[],roll_and_claim:[],cancel_room:[],resign:[],danmaku:['text','style','battleRound']};
+  const kind=text(a.kind);if(!Object.hasOwn(spec,kind)) fail('未知棋局操作');
+  const result:Record<string,unknown>={kind};
+  for(const key of spec[kind]!) {
+    if(a[key]===undefined && ['times','style','battleRound'].includes(key)) continue;
+    if(['index','row','col','times','battleRound'].includes(key)) {
+      if(!Number.isInteger(a[key]) || (a[key] as number)<0 || (a[key] as number)>100) fail('数值参数无效');
+    } else if(typeof a[key]!=='string'||(a[key] as string).length>160) fail('文字参数无效');
+    result[key]=a[key];
+  }
+  return result as RoomAction;
+}
+export async function cedarWeb(store:RoomStore, identity:PlatformIdentity, op:unknown, p:Record<string,unknown>, household:SeatOwner[]=[],economy=false) {
+  if(op==='config') return {slim:!economy,economy,cursorEnabled:false,mcpUrl:'',packs:PACK_SUMMARIES,modes:LOBBY_MODES.map(mode=>({id:mode.id,name:mode.name})),rooms:store.platformRooms(identity.owner.accountId)};
+  if(op==='create') {
+    // Validate through the same store; names and household come only from trusted platform context.
+    return store.createForPlatform(identity.owner,text(p.requestId),p.pack===undefined?undefined:text(p.pack),p.mode===undefined?'standard':text(p.mode),p.seats as number|undefined,household);
+  }
+  if(op==='join') {
+    const seat=store.joinForPlatform(text(p.invitation),identity.owner);
+    return {roomId:seat.roomId,duplicate:seat.duplicate===true};
+  }
+  const roomId=text(p.roomId);
+  if(!/^[a-f0-9]{12}$/.test(roomId)) fail('房间编号无效');
+  const credentials=store.accountSeat(roomId,identity.owner.accountId)??fail('你没有这间房的席位');
+  if(op==='state') {
+    const view=store.view(credentials);
+    if(p.watch===true) delete view.self;
+    return clean(view);
+  }
+  if(p.watch===true) fail('围观只能读取');
+  if(op==='invite') return {invitation:store.invite(credentials).invitation};
+  if(op==='start') return clean(store.start(credentials,text(p.requestId)));
+  if(op==='action') {
+    const command=action(p.action);
+    if(!Number.isInteger(p.round)||!Number.isInteger(p.revision)) fail('需要当前 round/revision');
+    const before=store.view(credentials);
+    if(before.phase==='waiting'&&!['danmaku','cancel_room'].includes(command.kind)) fail(before.seatIndex===0?(before.seats.length<(before.seatCount??2)?'你是房主，请先点「补路人机，直接开局」；也可先邀请好友入座。':'你是房主，请先点「开始棋局」。'):'请等待房主开始；开局后再选择装备或操作棋子。');
+    return clean(store.mutate({...credentials,round:p.round as number,revision:p.revision as number,requestId:text(p.requestId),action:command}));
+  }
+  fail('未知网页操作');
+}
