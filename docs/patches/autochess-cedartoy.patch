@@ -0,0 +1,100 @@
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { RoomStore } from '../lib/autochess/room-store';
+import { platformIdentity, PlatformRoomAdapter } from '../lib/autochess/platform-adapter';
+
+const owner = (id: string) => platformIdentity({playerId:id}).owner;
+const fixture = (t: any) => { const dir=mkdtempSync(join(tmpdir(),'cedar-chess-')); t.after(()=>rmSync(dir,{recursive:true,force:true})); return dir; };
+
+test('private invitation keeps eight human seats waiting; only host can fill and start', async t => {
+  const store=new RoomStore(fixture(t));
+  const host=owner('42');
+  const room=store.createForPlatform(host,'create-eight-1','ai','standard',8);
+  for(let i=1;i<8;i++) {
+    const guest=owner(String(100+i));
+    const seat=store.joinForPlatform(room.invitation,guest);
+    assert.equal(store.view(seat).seatIndex,i);
+    assert.equal(store.view(seat).phase,'waiting');
+    assert.throws(()=>store.start(seat,'start-eight-1'),/房主/);
+  }
+  assert.throws(()=>store.joinForPlatform(room.invitation,owner('999')),/满员/);
+  assert.throws(()=>store.joinForPlatform(room.roomId,owner('999')),/邀请/);
+  const credentials=store.accountSeat(room.roomId,host.accountId)!;
+  const start=store.start(credentials,'start-eight-1');
+  assert.equal(start.seats.filter(s=>s.bot).length,0);
+  assert.equal(start.phase,'prepare');
+  assert.equal(store.start(credentials,'start-eight-1').revision,start.revision);
+});
+
+test('solo NPC fill preserves both packs, available modes and configurable even capacities', t => {
+  const store=new RoomStore(fixture(t));
+  for(const pack of ['ai','jianghu']) for(const [mode,count] of [['duel',2],['standard',8],['standard',4],['standard',16]] as const) {
+    const host=owner(`guest:${pack}-${mode}-${count}`);
+    const room=store.createForPlatform(host,`create-${pack}-${mode}-${count}`,pack,mode,count);
+    const view=store.start(store.accountSeat(room.roomId,host.accountId)!,`start-${pack}-${mode}-${count}`);
+    assert.equal(view.mode,mode); assert.equal(view.pack,pack); assert.equal(view.seats.length,count);
+    assert.equal(view.seats.filter(s=>s.bot).length,count-1);
+  }
+  assert.throws(()=>store.createForPlatform(owner('1'),'invalid-mode','ai','frenzy'),/未开放/);
+  assert.throws(()=>store.createForPlatform(owner('1'),'invalid-size','ai','duel',8),/固定/);
+  assert.throws(()=>store.createForPlatform(owner('1'),'invalid-odd1','ai','standard',3),/偶数/);
+});
+
+test('concurrent retries and cold restore retain seats, receipts and identity isolation', async t => {
+  const directory=fixture(t); let store=new RoomStore(directory); let adapter=new PlatformRoomAdapter(store);
+  const host=platformIdentity({playerId:'42'});
+  const created:any[]=await Promise.all(Array.from({length:10},()=>adapter.play(host,'create',{requestId:'same-create-1',pack:'jianghu',mode:'standard',seats:4}))) as any[];
+  assert.equal(new Set(created.map(r=>r.roomId)).size,1);
+  const roomId=created[0].roomId;
+  await assert.rejects(adapter.play(host,'create',{requestId:'same-create-1',pack:'ai'}),/不同开房/);
+  for(const id of ['43','42:2','guest:42']) {
+    const identity=platformIdentity({playerId:id});
+    await assert.rejects(adapter.play(identity,'read',{roomId,player_id:'42'}),/没有/);
+    await adapter.play(identity,'join',{invitation:created[0].invitation});
+  }
+  await adapter.play(host,'start',{roomId,requestId:'same-start-1'});
+  const view:any=await adapter.play(host,'read',{roomId});
+  const params={roomId,round:view.round,revision:view.self.revision,requestId:'same-action-1',kind:'say',text:'跨进程保留'};
+  await Promise.all(Array.from({length:10},()=>adapter.play(host,'act',params)));
+  store=new RoomStore(directory);adapter=new PlatformRoomAdapter(store);
+  const restored:any=await adapter.play(host,'read',{roomId});
+  assert.equal(restored.seatIndex,0);
+  const raw=JSON.parse(readFileSync(join(directory,roomId+'.json'),'utf8'));
+  assert.equal(raw.danmaku.length,1);
+  assert.equal(raw.seats.length,4);
+  await adapter.play(host,'act',params);
+  const reply=JSON.stringify(await adapter.play(host,'start',{roomId,requestId:'same-start-1'}));
+  assert.ok(!/"(?:token|watchToken|accountToken|accountId)"/.test(reply));
+  assert.equal((await adapter.play(platformIdentity({playerId:'42:2'}),'read',{roomId}) as any).seatIndex,2);
+});
+
+test('bad saves fail closed without overwriting the original', t => {
+  const directory=fixture(t);const file=join(directory,'abcdef123456.json');
+  writeFileSync(file,'broken-json');assert.throws(()=>new RoomStore(directory));
+  assert.equal(readFileSync(file,'utf8'),'broken-json');
+  assert.ok(!readdirSync(directory).some(name=>name.endsWith('.pending')));
+});
+
+test('failed atomic rename reports an error and preserves both prior disk and in-memory state', async t => {
+  const fs = (await import('node:fs')).default;
+  const { syncBuiltinESMExports } = await import('node:module');
+  const { mock } = await import('node:test');
+  const directory=fixture(t);const store=new RoomStore(directory);const host=owner('42');
+  const room=store.createForPlatform(host,'failure-create-1');
+  const credentials=store.accountSeat(room.roomId,host.accountId)!;
+  const before=store.view(credentials);const file=join(directory,room.roomId+'.json');
+  const saved=readFileSync(file,'utf8');
+  const rename=mock.method(fs,'renameSync',()=>{throw Object.assign(new Error('disk unavailable'),{code:'EIO'});});
+  syncBuiltinESMExports();
+  try {
+    assert.throws(()=>store.start(credentials,'failure-start-1'),/disk unavailable/);
+    assert.equal(readFileSync(file,'utf8'),saved);
+    assert.equal(store.view(credentials).revision,before.revision);
+    assert.equal(store.view(credentials).phase,'waiting');
+    assert.ok(!readdirSync(directory).some(name=>name.endsWith('.pending')));
+  } finally { rename.mock.restore(); syncBuiltinESMExports(); }
+  assert.equal(store.start(credentials,'failure-start-1').phase,'prepare');
+});
