+import React,{useEffect,useState} from 'react';
+import {cedarRequest} from './transport';
+import './game-stats.css';
+const RANGES=[['1h','1小时'],['24h','24小时'],['7d','7天'],['14d','14天'],['30d','30天'],['all','全部记录']];
+type Report={range:string;generated_at:string;started:number;modes:{id:string;name:string}[];packs:{id:string;name:string;started:number;by_mode:Record<string,number>}[]};
+function validate(data:Report,range:string){
+ const count=(n:number)=>Number.isSafeInteger(n)&&n>=0;
+ if(data.range!==range||!count(data.started)||data.modes?.map(m=>m.id).join(',')!=='standard,duel'||data.packs?.map(p=>p.id).join(',')!=='ai,jianghu'||
+  data.packs.some(p=>!count(p.started)||data.modes.some(m=>!count(p.by_mode?.[m.id]))||data.modes.reduce((n,m)=>n+p.by_mode[m.id],0)!==p.started)||data.packs.reduce((n,p)=>n+p.started,0)!==data.started)throw Error('统计结果格式无效');
+ return data;
+}
+export default function GameStats({onBack,onDenied}:{onBack:()=>void;onDenied:()=>void}){
+ const [range,setRange]=useState('7d'),[attempt,setAttempt]=useState(0),[report,setReport]=useState<Report>(),[error,setError]=useState('');
+ useEffect(()=>{
+  let active=true;setReport(undefined);setError('');
+  void cedarRequest<Report>('stats',{view:'breakdown',range}).then(data=>{if(active)setReport(validate(data,range));}).catch(e=>{
+   if(!active)return;
+   if(e.status===403){onDenied();return;}setError(e.message||'统计暂时不可用');
+  });
+  return()=>{active=false;};
+ },[range,attempt]);
+ return <main className="yijian-management" aria-label="弈间独立统计">
+  <div className="management-shell"><header className="management-head"><h1>弈间 · 游玩统计</h1><button onClick={onBack}>返回棋室</button></header>
+   <section className="management-panel" aria-busy={!report&&!error}>
+    <div className="section-head"><h2>已开始棋局</h2><label className="dashboard-control">范围 <select aria-label="统计范围" value={range} onChange={e=>{setReport(undefined);setError('');setRange(e.target.value);}}>{RANGES.map(([id,label])=><option key={id} value={id}>{label}</option>)}</select></label></div>
+    {error?<p role="alert">{error} <button onClick={()=>setAttempt(n=>n+1)}>重试</button></p>:!report?<p role="status">正在读取…</p>:<>
+     <table className="game-overview"><caption>按棋谱与模式统计，单位：场</caption><thead><tr><th scope="col">棋谱</th>{report.modes.map(m=><th key={m.id} scope="col">{m.name}</th>)}<th scope="col">合计</th></tr></thead><tbody>{report.packs.map(p=><tr key={p.id}><th scope="row">{p.name}</th>{report.modes.map(m=><td key={m.id}>{p.by_mode[m.id]}</td>)}<td>{p.started}</td></tr>)}</tbody><tfoot><tr><th scope="row">合计</th>{report.modes.map(m=><td key={m.id}>{report.packs.reduce((n,p)=>n+p.by_mode[m.id],0)}</td>)}<td>{report.started}</td></tr></tfoot></table>
+     <p className="section-note">{report.started?'只计已开始的本游戏棋局，不含等待开局的房间。':'所选范围暂无已开始的棋局。'}{range==='all'?' 全部仅指仍保留的本游戏房间存档。':''}</p>
+    </>}
+   </section>
+  </div>
+ </main>;
+}
