+import test from 'node:test';
+import assert from 'node:assert/strict';
+// The renderer's pinned Three.js package is JS-only (no bundled declarations).
+// @ts-expect-error Same runtime module used by arena-renderer.js.
+import * as T from 'three';
+import {artworkViewport} from '../lib/autochess/artwork-board.js';
+import {BOARD_SCENES} from '../lib/meta/board-scenes.js';
+import {BOARD_ROWS,BOARD_COLS} from '../lib/autochess/constants';
+
+const sizes=[[360,780],[390,844],[691,1536]];
+test('portrait framing keeps every painted grid and reserve inside control lanes at each zoom',()=>{
+  for(const scene of BOARD_SCENES){
+    const art=scene.artwork;
+    if(!art)continue;
+    for(const [w,h] of sizes)for(const zoom of [1,.9,.78])for(const safe of [0,24]){
+      const insetTop=122+safe,insetBottom=110+safe;
+      const view=artworkViewport(w,h,art,zoom,insetTop,insetBottom);
+      const points=[...art.corners,art.bench.first,art.bench.last];
+      for(const [x,y] of points){
+        const px=view.left+x/art.size*view.size,py=view.top+y/art.size*view.size;
+        assert(px>=0&&px<=w,`${scene.id}: horizontal cell/reserve clipping`);
+        assert(py>=insetTop&&py<=h-insetBottom,`${scene.id}: cell/reserve under controls`);
+      }
+      // Even the least zoomed portrait view gives the grid more space than the
+      // former screen-width square, without stretching either axis.
+      assert(view.size>w,`${scene.id}: unused portrait space`);
+    }
+  }
+});
+
+test('shared square projection round-trips every cell center after portrait resize',()=>{
+  const camera=new T.PerspectiveCamera(42,1,.1,100);
+  camera.position.set(0,14,12);camera.lookAt(0,0,0);camera.updateMatrixWorld();
+  const ray=new T.Raycaster(),floor=new T.Plane(new T.Vector3(0,1,0),0);
+  for(const scene of BOARD_SCENES){
+    const art=scene.artwork;
+    if(!art)continue;
+    for(const [w,h] of sizes){
+      const view=artworkViewport(w,h,art,1,122,110);
+      const [tl,tr,br,bl]=art.corners;
+      for(let r=0;r<BOARD_ROWS;r++)for(let c=0;c<BOARD_COLS;c++){
+        const t=(r+.5)/BOARD_ROWS,s=(c+.5)/BOARD_COLS;
+        const x=T.MathUtils.lerp(T.MathUtils.lerp(tl[0],bl[0],t),T.MathUtils.lerp(tr[0],br[0],t),s);
+        const y=T.MathUtils.lerp(tl[1],bl[1],t);
+        const px=view.left+x/art.size*view.size,py=view.top+y/art.size*view.size;
+        ray.setFromCamera(new T.Vector2((px-view.left)/view.size*2-1,1-(py-view.top)/view.size*2),camera);
+        const world=ray.ray.intersectPlane(floor,new T.Vector3());
+        assert(world);
+        const projected=world.project(camera);
+        assert(Math.abs(view.left+(projected.x+1)/2*view.size-px)<1e-6);
+        assert(Math.abs(view.top+(1-projected.y)/2*view.size-py)<1e-6);
+      }
+    }
+  }
+});
+
+test('compact landscape and desktop keep their existing square frame',()=>{
+  for(const [w,h] of [[740,345],[844,390],[1440,900]])for(const zoom of [1,.78]){
+    const landscape=w>h&&h<600;
+    const size=Math.min(landscape?w-200:w,h*(landscape?1.16:1.04))/zoom;
