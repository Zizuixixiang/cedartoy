+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {mkdtempSync,rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {RoomStore} from '../lib/autochess/room-store';
+import {platformIdentity} from '../lib/autochess/platform-adapter';
+
+test('Yijian management uses real started rooms grouped by pack and mode, not invitations', t => {
+  const dir = mkdtempSync(join(tmpdir(),'yijian-admin-counts-'));
+  t.after(() => rmSync(dir,{recursive:true,force:true}));
+  const store = new RoomStore(dir);
+  const host = platformIdentity({playerId:'101',actorType:'human',displayName:'PRIVATE_TEST_NAME'});
+  const counts = [['ai','standard'],['ai','duel'],['jianghu','standard'],['jianghu','duel']] as const;
+  for (const [pack,mode] of counts) {
+    const made = store.createForPlatform(host.owner, 'dashboard-start-'+pack+'-'+mode, pack, mode);
+    const seat = store.accountSeat(made.roomId,host.owner.accountId)!;
+    store.start(seat,'dashboard-go-'+pack+'-'+mode);
+  }
+  store.createForPlatform(host.owner,'dashboard-unstarted','ai','standard');
+  const summary = store.platformPlayBreakdown(0,Date.now()+1000);
+  assert.equal(summary.started,4);
+  assert.deepEqual(summary.modes.map(mode=>mode.id),['standard','duel']);
+  assert.deepEqual(summary.packs.map(pack=>[pack.id,pack.started]),[['ai',2],['jianghu',2]]);
+  for(const pack of summary.packs) {
+    assert.equal(pack.by_mode.standard,1);
+    assert.equal(pack.by_mode.duel,1);
+  }
+  const text = JSON.stringify(summary);
+  assert(!text.includes('PRIVATE_TEST_NAME'));
+  assert(!text.includes('roomId'));
+  assert(!text.includes('accountId'));
+  assert(!text.includes('invitation'));
+  assert.equal(store.platformPlayBreakdown(Date.now()+5000,Date.now()+10000).started,0);
+  assert.deepEqual(new RoomStore(dir).platformPlayBreakdown(0,Date.now()+1000),summary);
+});
