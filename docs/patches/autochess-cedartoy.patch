+++ b/test/cedartoy-http.test.ts
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { cedarServer } from '../scripts/cedartoy-server';
+import { RoomStore } from '../lib/autochess/room-store';
+
+test('private HTTP listener denies original routes, foreign origins, cookies and forged secrets', async t => {
+  const dir=mkdtempSync(join(tmpdir(),'autochess-http-'));
+  t.after(()=>rmSync(dir,{recursive:true,force:true}));
+  const secret='a'.repeat(64);
+  const server=cedarServer(new RoomStore(dir),secret);
+  await new Promise<void>((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',resolve);});
+  t.after(()=>new Promise<void>(resolve=>{server.closeAllConnections();server.close(()=>resolve());}));
+  const port=(server.address() as any).port;
+  const url=`http://127.0.0.1:${port}`;
+  const headers={'X-Autochess-Platform-Secret':secret,'X-Player-Id':'42','Content-Type':'application/json'};
+  for(const path of ['/room','/account','/mcp','/player','/match','/feedback','/platform/autochess?x=1']) {
+    const response=await fetch(url+path,{method:'POST',headers,body:'{}'});
+    assert.equal(response.status,404);
+  }
+  for(const extra of <Record<string,string>[]>[{'X-Autochess-Platform-Secret':'wrong'}, {'Origin':'https://toy.cedarstar.org'}, {'Cookie':'token=secret'}, {'Authorization':'Bearer secret'}]) {
+    assert.equal((await fetch(url+'/platform/autochess',{method:'POST',headers:{...headers,...extra},body:'{}'})).status,403);
+  }
+  const response=await fetch(url+'/platform/autochess',{method:'POST',headers,body:JSON.stringify({action:'create',params:{requestId:'http-create-1'}})});
+  assert.equal(response.status,200);
+  const room:any=await response.json();
+  const other=await fetch(url+'/platform/autochess',{method:'POST',headers:{...headers,'X-Player-Id':'43'},body:JSON.stringify({action:'read',params:{roomId:room.roomId,player_id:'42'}})});
+  assert.equal(other.status,400);
+});
