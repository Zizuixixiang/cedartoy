+/** Square art/canvas/labels share this viewport; only decorative margins may clip. */
+export function artworkViewport(w,h,data,zoom=1,insetTop=0,insetBottom=0) {
+  if(w<=768&&h>=w){
+    // Include reserves and space above pieces/labels, not just grid corners.
+    const points=[...data.corners,data.bench.first,data.bench.last];
+    const left=Math.min(...points.map(p=>p[0]))-56;
+    const right=Math.max(...points.map(p=>p[0]))+56;
+    const top=Math.min(...points.map(p=>p[1]))-96;
+    const bottom=Math.max(...points.map(p=>p[1]))+56;
+    const height=Math.max(1,h-insetTop-insetBottom);
+    const fit=Math.min(w*data.size/(right-left),height*data.size/(bottom-top));
+    // Zoom stops at the playable bounds instead of cutting off outer cells.
+    const size=Math.max(1,fit*Math.min(1,.9/Math.max(.78,zoom)));
+    return {size,left:w/2-(left+right)/2/data.size*size,
+      top:insetTop+height/2-(top+bottom)/2/data.size*size};
+  }
+  // Preserve the established landscape and desktop framing.
+  const landscape=w>h&&h<600,available=landscape?w-200:w;
+  const size=Math.max(1,Math.min(available,h*(landscape?1.16:1.04))/Math.min(1,Math.max(.78,zoom)));
+  return {size,left:(w-size)/2,top:(h-size)/2-(landscape?size*.045:0)};
+}
