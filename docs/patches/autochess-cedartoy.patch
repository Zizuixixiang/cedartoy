+ root,
+ base:'/autochess/static/',
+ plugins:[{name:'cedar-transport',enforce:'pre',resolveId(source,importer){
+  if(importer&&source==='./room-request')return root+'cedartoy/transport.ts';
+ },transform(code,id){
+  if(id.endsWith('/lib/meta/board-scenes.js')||id.endsWith('/lib/meta/cosmetics.ts'))
+    return code.replace(/(['"])\/(boards|frames)\//g, '$1/autochess/static/$2/');
