+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { cedarServer } from '../scripts/cedartoy-server';
+import { RoomStore } from '../lib/autochess/room-store';
+
+test('private HTTP listener denies original routes, foreign origins, cookies and forged secrets', async t => {
+  const dir=mkdtempSync(join(tmpdir(),'autochess-http-'));
+  t.after(()=>rmSync(dir,{recursive:true,force:true}));
+  const secret='a'.repeat(64);
+  const server=cedarServer(new RoomStore(dir),secret);
+  await new Promise<void>((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',resolve);});
+  t.after(()=>new Promise<void>(resolve=>{server.closeAllConnections();server.close(()=>resolve());}));
+  const port=(server.address() as any).port;
+  const url=`http://127.0.0.1:${port}`;
+  const headers={'X-Autochess-Platform-Secret':secret,'X-Player-Id':'42','Content-Type':'application/json'};
+  for(const path of ['/room','/account','/mcp','/player','/match','/feedback','/platform/autochess?x=1']) {
+    const response=await fetch(url+path,{method:'POST',headers,body:'{}'});
+    assert.equal(response.status,404);
+  }
+  for(const extra of <Record<string,string>[]>[{'X-Autochess-Platform-Secret':'wrong'}, {'Origin':'https://toy.cedarstar.org'}, {'Cookie':'token=secret'}, {'Authorization':'Bearer secret'}]) {
+    assert.equal((await fetch(url+'/platform/autochess',{method:'POST',headers:{...headers,...extra},body:'{}'})).status,403);
+  }
+  const response=await fetch(url+'/platform/autochess',{method:'POST',headers,body:JSON.stringify({action:'create',params:{requestId:'http-create-1'}})});
+  assert.equal(response.status,200);
+  const room:any=await response.json();
+  const other=await fetch(url+'/platform/autochess',{method:'POST',headers:{...headers,'X-Player-Id':'43'},body:JSON.stringify({action:'read',params:{roomId:room.roomId,player_id:'42'}})});
+  assert.equal(other.status,400);
+});
diff --git a/test/cedartoy-persistence.ts b/test/cedartoy-persistence.ts
new file mode 100644
index 0000000..f6dfe06
--- /dev/null
+++ b/test/cedartoy-persistence.ts
@@ -0,0 +1,66 @@
+/** Four separate processes, temporary saves only. Works with `node --import tsx`. */
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync, writeFileSync, readFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { CedarEconomy } from '../lib/accounts/cedartoy-economy';
+import {platformIdentity} from '../lib/autochess/platform-adapter';
+import {listedCosmetics,cosmeticPrice} from '../lib/meta/cosmetics';
+import { RoomStore } from '../lib/autochess/room-store';
+
+const [step, directory] = process.argv.slice(2);
+const owner={accountId:'platform:test:guest-regcheck',accountName:'临时验证'};
+if(step) {
+  const economy=new CedarEconomy(join(directory!,'economy'));
+  const human=platformIdentity({playerId:'951',actorType:'human'}),ai=platformIdentity({playerId:'952',actorType:'ai'});
+  const context=[{playerId:'951',name:'持久化人类',actorType:'human'},{playerId:'952',name:'持久化小机',actorType:'ai',owners:['951']}];
+  const meta=(who:typeof human,op:string,p:any={})=>economy.play(who,context,op,p) as any;
+  const skin=listedCosmetics().find(c=>c.kind==='board'&&c.acquisition!=='wheel'&&cosmeticPrice(c,'human')>0)!;
+  const frame=listedCosmetics().find(c=>c.kind==='frame'&&c.acquisition!=='wheel'&&c.acquisition!=='retired')!;
+  if(step==='create') {
+    economy.sync(human,context);
+    for(let i=0;i<3;i++)economy.settle({roomId:'fund-'+i,round:3,entries:[{accountId:human.owner.accountId,outcome:'win'},{accountId:ai.owner.accountId,outcome:'win'}]});
+  } else if(step==='mutate') {
+    meta(human,'buy',{cosmeticId:skin.id,requestId:'persistent-buy'});
+    meta(ai,'gift',{cosmeticId:frame.id,requestId:'persistent-gift'});
+  } else {
+    meta(human,'buy',{cosmeticId:skin.id,requestId:'persistent-buy'});
+    meta(ai,'gift',{cosmeticId:frame.id,requestId:'persistent-gift'});
+    let self=meta(human,'profile').self;
+    assert.equal(self.coins.human,84-cosmeticPrice(skin,'human'));assert.equal(self.giftHistory.length,1);
+    meta(human,'claim',{giftId:self.giftHistory[0].id,requestId:'persistent-claim'});
+    assert.equal(economy.appearance(human.owner.accountId)?.frame,frame.id);
+    assert.equal(economy.appearance(human.owner.accountId)?.skinId,skin.id);
+  }
+  economy.close();
+  if(step==='verify')process.exit(0);
+  const store=new RoomStore(directory!);
+  if(step==='create') {
+    const room=store.createForPlatform(owner,'persist-create-1','jianghu','standard',8);
+    writeFileSync(join(directory!,'fixture.json'),JSON.stringify(room));
+  } else {
+    const room=JSON.parse(readFileSync(join(directory!,'fixture.json'),'utf8'));
+    const credentials=store.accountSeat(room.roomId,owner.accountId)!;
+    if(step==='mutate') {
+      const view=store.start(credentials,'persist-start-1');
+      store.mutate({...credentials,round:view.round,revision:view.self!.revision,requestId:'persist-action-1',action:{kind:'danmaku',text:'冷启动后仍存在'}});
+    } else if(step==='read') {
+      const view=store.view(credentials);
+      assert.equal(view.pack,'jianghu');assert.equal(view.phase,'prepare');assert.equal(view.seats.filter(s=>s.bot).length,7);
+      assert.equal(view.danmaku!.filter(m=>m.text==='冷启动后仍存在').length,1);
+      assert.equal(store.createForPlatform(owner,'persist-create-1','jianghu','standard',8).roomId,room.roomId);
+      assert.equal(store.start(credentials,'persist-start-1').revision,view.revision);
+    } else throw Error('Unknown step');
+  }
+} else {
+  const dir=mkdtempSync(join(tmpdir(),'autochess-persist-'));
+  try {
+    for(const phase of ['create','mutate','read','verify']) {
+      const child=spawnSync(process.execPath,[...process.execArgv,fileURLToPath(import.meta.url),phase,dir],{encoding:'utf8',timeout:60000});
+      assert.equal(child.status,0,`${phase}: ${child.stderr}\n${child.stdout}`);
+    }
+    console.log('PASS: create -> independent mutate -> independent read -> independent verify; NPCs, identity, wallet, purchases, gifts/claims and receipts persisted');
+  } finally {rmSync(dir,{recursive:true,force:true});}
+}
diff --git a/test/cedartoy-private.test.ts b/test/cedartoy-private.test.ts
new file mode 100644
index 0000000..f0c7259
