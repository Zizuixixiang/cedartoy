+test('satellite listening hook mounts 20-minute unref maintenance; no requests; close clears it', t => {
+  const f = fixture(t), room = f.make('timer-create');
+  let callback: (() => void) | undefined, timer: NodeJS.Timeout | undefined;
+  const realSetInterval = globalThis.setInterval;
+  t.mock.method(globalThis, 'setInterval', (fn: () => void, delay: number) => {
+    assert.equal(delay, 20 * 60_000); callback = fn; timer = realSetInterval(() => {}, delay); return timer;
