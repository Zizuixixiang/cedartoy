+ useEffect(()=>{setConfig(undefined);setSelected([]);void refresh();},[slot,ai]);
+ useEffect(()=>{let previous=localStorage.getItem('cedartoy_token');const changed=()=>{const next=localStorage.getItem('cedartoy_token');if(next!==previous){previous=next;setRoom('');setConfig(undefined);setSelected([]);setAI('');setScope({slot});void refresh();}};window.addEventListener('storage',changed);document.addEventListener('visibilitychange',changed);return()=>{window.removeEventListener('storage',changed);document.removeEventListener('visibilitychange',changed);};},[slot,ai]);
+ const enter=(id:string,observe=false)=>{setScope({slot,ai_id:ai||undefined,watch:observe||!!ai});setWatch(observe||!!ai);setRoom(id);};
+ const run=async(fn:()=>Promise<void>)=>{if(busy)return;setBusy(true);setError('');try{await fn();}catch(e){setError((e as Error).message);}finally{setBusy(false);}};
+ const create=()=>run(async()=>{
+  const signature=JSON.stringify([slot,pack,mode,seats,selected]);
+  if(createAttempt.current?.signature!==signature)createAttempt.current={signature,id:crypto.randomUUID()};
+  const result=await roomRequest('create',{pack,mode,seats:mode==='duel'?2:seats,ai_ids:selected,requestId:createAttempt.current!.id});
+  createAttempt.current=undefined;enter(result.roomId);
+ });
+ return <>{!room?<header className="cedar-top"><a href="/">← 4399</a><strong>私人自走棋</strong><span>{config?.name}</span>{room?<button onClick={()=>{setRoom('');setWatch(false);void refresh();}}>返回棋室</button>:null}</header>:null}
+ {room?<RoomApp key={`${room}:${slot}:${ai}:${watch}`} cedar initialCredentials={{roomId:room,token:''}} onSessionChange={()=>{setRoom('');void refresh();}}/>:<main className="cedar-room">
+ <h1>自己的棋室</h1><p className="cedar-muted">一人也能开局，空位由 NPC 补齐。也可以带上自家小机，或邀请好友入座后再开始。</p>
+ {error?<p role="alert" className="cedar-error">{error}</p>:null}
+ {!config?<><a className="cedar-button" href="/" target="_blank" rel="noopener">去 4399 登录</a><button disabled={busy} onClick={()=>void refresh()}>重新连接</button></>:<>
+ <div className="cedar-fields"><label>存档槽<select aria-label="存档槽" value={slot} onChange={e=>setSlot(Number(e.target.value))}>{[1,2,3,4,5].map(x=><option key={x}>{x}</option>)}</select></label><label>棋局归属<select aria-label="棋局归属" value={ai} onChange={e=>setAI(e.target.value)}><option value="">我的棋局</option>{config.machines.map((x:any)=><option key={x.id} value={x.id}>观看 {x.name}</option>)}</select></label></div>
+ {!ai?<section aria-labelledby="create-title"><h2 id="create-title">开一间私人房</h2><div className="cedar-fields"><label>棋谱<select aria-label="棋谱" value={pack} onChange={e=>setPack(e.target.value)}>{config.packs.map((p:any)=><option key={p.id} value={p.id}>{p.name}</option>)}</select></label><label>模式<select aria-label="模式" value={mode} onChange={e=>setMode(e.target.value)}>{config.modes.map((m:any)=><option key={m.id} value={m.id}>{m.name}</option>)}</select></label>{mode==='standard'?<label>总席位<select aria-label="总席位" value={seats} onChange={e=>setSeats(Number(e.target.value))}>{[2,4,6,8,10,12,14,16].map(n=><option key={n}>{n}</option>)}</select></label>:null}</div>
+ {config.machines.length?<fieldset><legend>带上自家小机</legend>{config.machines.map((m:any)=><label className="cedar-check" key={m.id}><input type="checkbox" checked={selected.includes(m.id)} onChange={e=>setSelected(old=>e.target.checked?[...old,m.id]:old.filter(x=>x!==m.id))}/>{m.name}</label>)}<p className="cedar-muted">小机使用同一存档槽，从根 MCP 的 rooms 找到席位后行动；这里不会自动唤醒它。</p></fieldset>:null}
+ <button className="cedar-primary" disabled={busy||selected.length>=(mode==='duel'?2:seats)} onClick={create}>创建私人房</button><p className="cedar-muted">进入棋盘后，由房主点「补路人机，直接开局」。开始前可继续邀请好友。</p>
+ <form onSubmit={e=>{e.preventDefault();void run(async()=>{const result=await roomRequest('join',{invitation});history.replaceState(null,'','/autochess/');enter(result.roomId);});}}><label>好友邀请<input value={invitation} onChange={e=>setInvitation(e.target.value)} placeholder="粘贴邀请码" required/></label><button disabled={busy||!invitation}>加入私人房</button></form></section>:null}
+ <section><h2>{ai?'小机的棋局':'我的棋局'}</h2>{config.rooms.length?config.rooms.map((r:Room)=><div className="cedar-saved" key={r.roomId}><div><strong>{r.packName} · {r.mode==='duel'?'双人':'标准'}</strong><small>{r.phase==='waiting'?`等待开局 · ${r.seats}/${r.capacity} 席`:r.phase==='finished'?'已结束 · 可查看棋盘':`第 ${r.round} 轮`}</small></div>{!ai?<button onClick={()=>enter(r.roomId)}>回到棋盘</button>:null}<button onClick={()=>enter(r.roomId,true)}>观看</button></div>):<p className="cedar-muted">此存档槽还没有棋局。</p>}</section>
+ {config.author_stats?<section><h2>作品统计 · 仅本人可见</h2><label>时间区间<select value={range} onChange={e=>{setRange(e.target.value);setStats(undefined);}}>{['10m','1h','6h','12h','24h'].map(x=><option key={x}>{x}</option>)}</select></label><button onClick={()=>void run(async()=>setStats(await cedarRequest('stats',{range})))}>查看聚合</button>{stats?<dl>{[['活跃人类','active_humans'],['活跃小机','active_machines'],['开房','created'],['开始','started'],['完成','finished']].map(([label,key])=><div key={key}><dt>{label}</dt><dd>{stats[key]??0}</dd></div>)}</dl>:null}<p className="cedar-muted">只含本游戏聚合计数；活跃按自行入座及游戏行动记录；预留小机席位与 NPC 不计入。</p></section>:null}
+ </>}
+ <footer>原作：江川雪 · 小红书 63657956652 · <a href="https://github.com/Cecilia-coding/AutoChess-MCP" target="_blank" rel="noopener noreferrer">AutoChess-MCP</a> · <a href="/autochess/static/LICENSE.txt">MIT 许可证</a></footer>
+ </main>}</>;
+}
+createRoot(document.getElementById('root')!).render(<App/>);
