+
+type Tab='start'|'shop'|'me'|'wheel';
+type Machine={id:string;name:string};
+type Room={roomId:string;packName:string;mode:string;phase:string;round:number;seats:number;capacity:number};
+type Config={name:string;machines:Machine[];packs:PackSummary[];modes:{id:string}[];rooms:Room[];economy:boolean;author_stats:boolean};
+const TABS=[{id:'start',label:'开始'},{id:'shop',label:'外观'},{id:'me',label:'我的'},{id:'wheel',label:'对对碰'}];
+function App(){
+ const [token,setToken]=useState(()=>localStorage.getItem('cedartoy_token')||'');
+ useEffect(()=>{const changed=()=>{const next=localStorage.getItem('cedartoy_token')||'';if(next!==token){setScope({slot:1},true);setToken(next);}};window.addEventListener('storage',changed);window.addEventListener('focus',changed);document.addEventListener('visibilitychange',changed);return()=>{window.removeEventListener('storage',changed);window.removeEventListener('focus',changed);document.removeEventListener('visibilitychange',changed);};},[token]);
+ return <Session key={token} signedIn={!!token}/>;
+}
+function Session({signedIn}:{signedIn:boolean}){
+ const [slot,setSlot]=useState(1),[ai,setAI]=useState(''),[tab,setTab]=useState<Tab>('start');
+ const changeScope=(nextSlot:number,nextAI:string)=>{setScope({slot:nextSlot,ai_id:nextAI||undefined},true);setSlot(nextSlot);setAI(nextAI);};
+ return <Lobby key={`${slot}:${ai}`} signedIn={signedIn} slot={slot} ai={ai} changeScope={changeScope} tab={tab} setTab={setTab}/>;
+}
+function Lobby({signedIn,slot,ai,changeScope,tab,setTab}:{signedIn:boolean;slot:number;ai:string;changeScope:(slot:number,ai:string)=>void;tab:Tab;setTab:(tab:Tab)=>void}){
+ const [config,setConfig]=useState<Config>(),[error,setError]=useState(''),[busy,setBusy]=useState(false);
+ const [selected,setSelected]=useState<string[]>([]),[pack,setPack]=useState('ai'),[mode,setMode]=useState<MatchModeId>('standard'),[seats,setSeats]=useState(8);
+ const [profile,setProfile]=useState<SelfAccount>(),[room,setRoom]=useState(''),[watch,setWatch]=useState(false);
+ const [invitation,setInvitation]=useState(()=>new URLSearchParams(location.hash.slice(1)).get('invite')||'');
+ const [management,setManagement]=useState(false);
+ const alive=useRef(true),locked=useRef(false),sequence=useRef(0);
+ const createAttempt=useRef<{signature:string;id:string}|undefined>(undefined);
+ const resetRoomScope=()=>setScope({slot,ai_id:ai||undefined});
+ const refresh=async()=>{const id=++sequence.current;try{const next=await cedarRequest<Config>('bootstrap');if(alive.current&&id===sequence.current){setConfig(next);setError('');}}catch(e){if(alive.current&&id===sequence.current)setError((e as Error).message);}};
+ useEffect(()=>{alive.current=true;resetRoomScope();if(signedIn){void refresh();void metaRequest<{self:SelfAccount}>('profile').then(p=>{if(alive.current)setProfile(p.self);}).catch(()=>{});}return()=>{alive.current=false;};},[]);
+ const enter=(id:string,observe=false)=>{if(!alive.current)return;setScope({slot,ai_id:ai||undefined,watch:observe||!!ai});setWatch(observe||!!ai);setRoom(id);};
+ const run=async(fn:()=>Promise<void>)=>{if(locked.current)return;locked.current=true;setBusy(true);setError('');try{await fn();}catch(e){if(alive.current)setError((e as Error).message);}finally{locked.current=false;if(alive.current)setBusy(false);}};
+ const create=()=>run(async()=>{
+  const signature=JSON.stringify([slot,pack,mode,seats,selected]);
+  if(createAttempt.current?.signature!==signature)createAttempt.current={signature,id:newRequestId()};
+  const result=await roomRequest('create',{pack,mode,seats:mode==='duel'?2:seats,ai_ids:selected,requestId:createAttempt.current.id});
+  if(alive.current){createAttempt.current=undefined;enter(result.roomId);}
+ });
