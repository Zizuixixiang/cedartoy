+++ b/test/cedartoy-transport.test.ts
@@ -0,0 +1,51 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {cedarRequest,setScope} from '../cedartoy/transport';
+
+// Browser transport security: a delayed real request must not revive a previous
+// wallet/room after navigation, even when the user returns to the same scope.
+test('Cedar transport rejects late responses across scope and account generations',async()=>{
+ const savedFetch=globalThis.fetch;
+ const savedStorage=Object.getOwnPropertyDescriptor(globalThis,'localStorage');
+ let token='test-human';
+ Object.defineProperty(globalThis,'localStorage',{configurable:true,value:{getItem:()=>token}});
+ let release!:(response:Response)=>void;
+ let sent:Record<string,unknown>={};
+ globalThis.fetch=async(_url,options)=>{sent=JSON.parse(options!.body as string);return new Promise<Response>(resolve=>{release=resolve;});};
+ try{
+  setScope({slot:1},true);
+  const scopeRequest=cedarRequest('economy',{op:'profile',slot:5});
+  assert.equal(sent.slot,1,'caller cannot override the selected scope');
+  setScope({slot:2});setScope({slot:1});
+  release(Response.json({self:{coins:{human:999}}}));
+  await assert.rejects(scopeRequest,/已切换/);
+  const accountRequest=cedarRequest('bootstrap');
+  token='other-human';setScope({slot:1},true);
+  token='test-human';setScope({slot:1},true);
+  release(Response.json({rooms:[{roomId:'old-room'}]}));
+  await assert.rejects(accountRequest,/已切换/);
+  const fresh=cedarRequest('bootstrap');
+  setScope({slot:1}); // Normal same-scope refresh must not cancel unrelated reads.
+  release(Response.json({rooms:[]}));
+  assert.deepEqual(await fresh,{rooms:[]});
+ }finally{
+  globalThis.fetch=savedFetch;
+  if(savedStorage)Object.defineProperty(globalThis,'localStorage',savedStorage);
+  else Reflect.deleteProperty(globalThis,'localStorage');
+  setScope({slot:1},true);
+ }
+});
+
+test('only known preconditions discard pending mutations; uncertain failures keep retry identity',async()=>{
+ const savedFetch=globalThis.fetch,savedStorage=Object.getOwnPropertyDescriptor(globalThis,'localStorage');
+ Object.defineProperty(globalThis,'localStorage',{configurable:true,value:{getItem:()=> 'fixture-token'}});
+ try{
+  for(const [status,message,retryable] of [[400,'你是房主，请先点「补路人机，直接开局」',false],[400,'请等待房主开始；开局后再选择装备或操作棋子。',false],[403,'权限已撤销',false],[400,'上游暂时无法连接',true],[503,'保存结果未知',true]] as const){
+   globalThis.fetch=async()=>Response.json({error:message},{status});
+   await assert.rejects(cedarRequest('room'),(error:any)=>error.message===message&&error.retryable===retryable);
+  }
+ }finally{
+  globalThis.fetch=savedFetch;
+  if(savedStorage)Object.defineProperty(globalThis,'localStorage',savedStorage);else Reflect.deleteProperty(globalThis,'localStorage');
+ }
+});
