+export default function Economy({tab,onTab,onProfile,readOnly=false}:{tab:'shop'|'me'|'wheel';onTab:(tab:'shop'|'me'|'wheel')=>void;onProfile:(self:SelfAccount)=>void;readOnly?:boolean}) {
