+  </section>:null}
+  {tab==='me'&&config?<section className="lobby-panel"><h2>我的棋室</h2><div className="lobby-row cedar-scope"><label>存档槽 <select aria-label="存档槽" value={slot} onChange={e=>changeScope(Number(e.target.value),ai)}>{[1,2,3,4,5].map(n=><option key={n}>{n}</option>)}</select></label><label>棋局归属 <select aria-label="棋局归属" value={ai} onChange={e=>changeScope(slot,e.target.value)}><option value="">我的棋局</option>{config.machines.map(m=><option key={m.id} value={m.id}>{m.name} · 只读</option>)}</select></label></div>
