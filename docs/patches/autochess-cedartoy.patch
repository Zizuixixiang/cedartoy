new file mode 100644
index 0000000..8ed5a80
--- /dev/null
+++ b/components/autochess/request-id.ts
@@ -0,0 +1,14 @@
+/** Browser request IDs: Web Crypto works in older WebViews where randomUUID is absent.
+ * Never use Math.random: these IDs deduplicate room and wallet mutations. */
+export function newRequestId(): string {
+  const secure = globalThis.crypto;
+  if (!secure || typeof secure.getRandomValues !== 'function') {
+    throw Error('当前浏览器不支持安全随机数，请更新浏览器后重试');
+  }
+  const bytes = new Uint8Array(16);
+  secure.getRandomValues(bytes);
+  bytes[6] = (bytes[6]! & 0x0f) | 0x40; // RFC 4122 v4
+  bytes[8] = (bytes[8]! & 0x3f) | 0x80;
+  const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
