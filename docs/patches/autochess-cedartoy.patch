index 0000000..4b04155
--- /dev/null
+++ b/test/browser-request-id.test.ts
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {webcrypto} from 'node:crypto';
+import {newRequestId} from '../components/autochess/request-id';
+
+function withBrowserCrypto<T>(fake: object | undefined, run: () => T): T {
+  const saved = Object.getOwnPropertyDescriptor(globalThis, 'crypto');
+  try {
+    Object.defineProperty(globalThis, 'crypto', {configurable: true, value: fake});
+    return run();
+  } finally {
+    if (saved) Object.defineProperty(globalThis, 'crypto', saved);
+    else Reflect.deleteProperty(globalThis, 'crypto');
+  }
+}
+
+test('secure request IDs work when older mobile WebView omits crypto.randomUUID', () => {
+  withBrowserCrypto({getRandomValues: (array: Uint8Array) => webcrypto.getRandomValues(array)}, () => {
+    assert.equal(typeof globalThis.crypto.randomUUID, 'undefined');
+    const ids = Array.from({length: 150}, () => newRequestId());
+    assert.equal(new Set(ids).size, ids.length);
+    for (const id of ids) {
+      assert.match(id, /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/);
+      assert.equal(id.length, 36);
+    }
+  });
+});
+
+test('unsafe random IDs are not silently substituted when Web Crypto is missing', () => {
+  withBrowserCrypto(undefined, () => {
+    assert.throws(() => newRequestId(), /不支持安全随机数/);
+  });
+});
