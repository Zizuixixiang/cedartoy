@@ -0,0 +1,300 @@
+import assert from 'node:assert/strict';
+import fs, { existsSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { syncBuiltinESMExports } from 'node:module';
+import { test, type TestContext } from 'node:test';
+import { RoomStore, type RoomRecorder } from '../lib/autochess/room-store';
+import { cedarServer } from '../scripts/cedartoy-server';
+import { CedarEconomy } from '../lib/accounts/cedartoy-economy';
+import { platformIdentity } from '../lib/autochess/platform-adapter';
+import type { RoomCredentials, RoomMutation } from '../lib/autochess/room-types';
+
+const DAY = 24 * 60 * 60 * 1000, WEEK = 7 * DAY, BASE = Date.UTC(2026, 9, 1);
+const host = { accountId: 'lifecycle:host', accountName: '临时棋手', actorType: 'human' as const };
+const peer = { accountId: 'lifecycle:peer', accountName: '临时棋友', actorType: 'human' as const };
+function fixture(t: TestContext, recorder?: RoomRecorder) {
+  const directory = mkdtempSync(join(tmpdir(), 'cedar-lifecycle-'));
+  t.after(() => rmSync(directory, { recursive: true, force: true }));
+  let clock = BASE;
+  t.mock.method(Date, 'now', () => clock);
+  const store = new RoomStore(directory, recorder);
+  const file = (id: string) => join(directory, id + '.json');
+  const raw = (id: string) => JSON.parse(readFileSync(file(id), 'utf8'));
+  const make = (key: string, pack = 'ai', mode = 'duel') => {
+    const made = store.createForPlatform(host, key, pack, mode, mode === 'duel' ? 2 : 8);
+    return { ...made, ...store.accountSeat(made.roomId, host.accountId)! };
+  };
+  return { directory, store, file, raw, make, at: (time: number) => { clock = time; } };
+}
+function act(store: RoomStore, credentials: RoomCredentials, action: RoomMutation['action'], requestId: string) {
+  const view = store.view(credentials);
+  return store.mutate({ ...credentials, round: view.round, revision: view.self!.revision, action, requestId });
+}
+function child(directory: string, time: number, code: string) {
+  const result = spawnSync(process.execPath, ['--import', 'tsx', '--input-type=module', '-e', `
+    import assert from 'node:assert/strict';
+    import {readFileSync,existsSync} from 'node:fs';
+    import {join} from 'node:path';
+    import {RoomStore} from './lib/autochess/room-store.ts';
+    Date.now=()=>${time};
+    const directory=process.env.LIFECYCLE_DIRECTORY;
+    const store=new RoomStore(directory);
+    ${code}
+  `], { cwd: new URL('..', import.meta.url), env: { ...process.env, LIFECYCLE_DIRECTORY: directory }, encoding: 'utf8', timeout: 30_000 });
+  assert.equal(result.status, 0, result.stderr || result.stdout);
+}
+
+test('both packs and modes: 6d23h59 survives; seven idle days draw; seven more days deletes', t => {
+  let settlements = 0;
+  const f = fixture(t, { settle() { settlements++; } });
+  const rooms = [];
+  for (const pack of ['ai', 'jianghu']) for (const mode of ['duel', 'standard']) for (const phase of ['waiting', 'prepare']) {
+    const room = f.make(`${pack}-${mode}-${phase}`, pack, mode);
+    if (phase === 'prepare') f.store.start(room, 'start-' + room.roomId);
+    rooms.push({ ...room, phase, revision: f.store.view(room).revision, hp: f.raw(room.roomId).seats.map((seat: any) => seat.hp) });
+  }
+  f.at(BASE + WEEK - 60_000);
+  for (const room of rooms) assert.equal(f.store.view(room).phase, room.phase);
+  f.at(BASE + WEEK);
+  assert(f.store.platformRooms(host.accountId).every(room => room.phase === 'finished'));
+  for (const room of rooms) {
+    const raw = f.raw(room.roomId), view = f.store.view(room);
+    assert.equal(view.winner, 'draw'); assert.equal(view.revision, room.revision + 1);
+    assert.equal(raw.finishReason, 'idle'); assert.equal(raw.terminalAt, BASE + WEEK);
+    assert.equal(raw.lastActionAt, BASE); assert.equal(raw.platformTimes.finished, undefined);
+    assert.equal(raw.settled, undefined); assert.deepEqual(raw.seats.map((seat: any) => seat.hp), room.hp);
+    assert(raw.seats.every((seat: any) => seat.result.outcome === 'draw' && !seat.result.reward && seat.result.payment !== 'pending'));
+  }
+  assert.equal(settlements, 0); assert.equal(f.store.platformStats(0, BASE + 2 * WEEK).finished, 0);
+  f.at(BASE + 2 * WEEK - 1); f.store.cleanup();
+  for (const room of rooms) assert(existsSync(f.file(room.roomId)));
+  f.at(BASE + 2 * WEEK); f.store.cleanup(); f.store.cleanup();
+  assert.equal(f.store.platformRooms(host.accountId).length, 0);
+  for (const room of rooms) { assert(!existsSync(f.file(room.roomId))); assert.throws(() => f.store.view(room), /不存在/); }
+  assert.equal(settlements, 0);
+  child(f.directory, BASE + 2 * WEEK, `assert.equal(store.platformRooms('${host.accountId}').length,0);`);
+});
+
+test('start, effective join and actual move reset idle; reads, retries, presence and chat do not', t => {
+  const f = fixture(t), room = f.make('activity-create');
+  f.at(BASE + 6 * DAY); f.store.joinForPlatform(room.invitation, peer);
+  assert.equal(f.raw(room.roomId).lastActionAt, BASE + 6 * DAY);
+  f.at(BASE + 7 * DAY); f.store.joinForPlatform(room.invitation, peer);
+  assert.equal(f.raw(room.roomId).lastActionAt, BASE + 6 * DAY);
+  f.store.start(room, 'activity-start');
+  assert.equal(f.raw(room.roomId).lastActionAt, BASE + 7 * DAY);
+  const moveAt = BASE + 14 * DAY - 60_000; // Exactly 6d23h59 after start still allows a real move.
+  f.at(moveAt);
+  const pieces = f.store.view(room).self!.bench!; assert(pieces.length > 0);
+  const piece = pieces[0]!;
+  const move = { kind: 'move' as const, piece: piece.id, row: 0, col: 0 };
+  const beforeMove = f.store.view(room);
+  const input = { ...room, round: beforeMove.round, revision: beforeMove.self!.revision, action: move, requestId: 'actual-board-move' };
+  f.store.mutate(input);
+  assert.equal(f.raw(room.roomId).lastActionAt, moveAt);
+  f.at(BASE + 14 * DAY); f.store.mutate(input); f.store.start(room, 'activity-start');
+  assert.throws(() => act(f.store, room, { kind: 'move', piece: 'missing', row: 0, col: 0 }, 'invalid-board-move'));
+  const saved = readFileSync(f.file(room.roomId), 'utf8');
+  for (let i = 0; i < 10; i++) { f.store.view(room); f.store.accountSeat(room.roomId, host.accountId); f.store.platformRooms(host.accountId); f.store.cleanup(); }
+  assert.equal(readFileSync(f.file(room.roomId), 'utf8'), saved);
+  act(f.store, room, { kind: 'danmaku', text: '只是聊天' }, 'activity-chat');
+  assert.equal(f.raw(room.roomId).updatedAt, BASE + 14 * DAY);
+  assert.equal(f.raw(room.roomId).lastActionAt, moveAt);
+  f.at(moveAt + WEEK - 1); assert.equal(f.store.view(room).phase, 'prepare');
+  f.at(moveAt + WEEK); assert.equal(f.store.view(room).phase, 'finished');
+});
+
+test('cancellation, resignation and normal completion retain from actual terminal time', t => {
+  const f = fixture(t);
