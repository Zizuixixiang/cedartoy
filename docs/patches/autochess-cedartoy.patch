+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {mkdtempSync,rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {RoomStore} from '../lib/autochess/room-store';
+import {platformIdentity,PlatformRoomAdapter} from '../lib/autochess/platform-adapter';
+import {cedarWeb} from '../lib/autochess/cedartoy-web';
+
+test('private Web household, invitations, owner start, spectating and durable aggregate isolation',async t=>{
+ const dir=mkdtempSync(join(tmpdir(),'cedar-web-'));t.after(()=>rmSync(dir,{force:true,recursive:true}));
+ const store=new RoomStore(dir),host=platformIdentity({playerId:'41:2',actorType:'human'}),ai=platformIdentity({playerId:'42:2',actorType:'ai'}),friend=platformIdentity({playerId:'43',actorType:'human'});
+ const call=(who:any,op:string,p:any={})=>cedarWeb(store,who,op,p);
+ const created:any=await cedarWeb(store,host,'create',{requestId:'web-create-123',pack:'jianghu',mode:'standard',seats:8},[ai.owner]);
+ assert.equal((await call(host,'config')).rooms.length,1);assert.equal((await call(platformIdentity({playerId:'41'}),'config')).rooms.length,0);
+ assert.equal((await call(ai,'config')).rooms.length,1);
+ await assert.rejects(call(friend,'state',{roomId:created.roomId}));
+ const joined=await call(friend,'join',{invitation:created.invitation});assert.equal(joined.roomId,created.roomId);
+ await assert.rejects(call(friend,'start',{roomId:created.roomId,requestId:'friend-start-123'}));
+ const params={roomId:created.roomId,requestId:'host-start-123'};
+ const [started,retried]:any[]=await Promise.all([call(host,'start',params),call(host,'start',params)]);
+ assert.equal(started.phase,'prepare');assert.equal(started.seats.length,8);assert.equal(started.seats.filter((s:any)=>s.bot).length,5);assert.equal(started.revision,retried.revision);
+ for(const name of ['token','accountId','actorKey','watchToken'])assert(!JSON.stringify(started).includes('"'+name+'"'));
+ const watch:any=await call(ai,'state',{roomId:created.roomId,watch:true});assert(!watch.self);assert.equal(watch.seatIndex,1);
+ await assert.rejects(call(ai,'action',{roomId:created.roomId,watch:true}));
+ const resumed=new RoomStore(dir);assert.equal(resumed.platformRooms(ai.owner.accountId)[0]!.roomId,created.roomId);
+ const stats=resumed.platformStats(Date.now()-3600000,Date.now()+1);assert.deepEqual(stats,{active_humans:2,active_machines:0,created:1,started:1,finished:0});
+ const mcp=new PlatformRoomAdapter(resumed);assert.equal((await mcp.play(ai,'rooms',{}) as any).rooms.length,1);
+});
+
+test('original web actions work through cleaned transport and retries do not repeat mutations',async t=>{
+ const dir=mkdtempSync(join(tmpdir(),'cedar-web-actions-'));t.after(()=>rmSync(dir,{force:true,recursive:true}));
+ const store=new RoomStore(dir),host=platformIdentity({playerId:'81',actorType:'human'});
+ for(const pack of ['ai','jianghu']){
+  const made:any=await cedarWeb(store,host,'create',{pack,mode:'duel',requestId:'actions-create-'+pack});
+  let view:any=await cedarWeb(store,host,'start',{roomId:made.roomId,requestId:'actions-start-'+pack});
+  if(view.self.swordOffer)view=await cedarWeb(store,host,'action',{roomId:view.id,round:view.round,revision:view.self.revision,requestId:'actions-sword-'+pack,action:{kind:'pick_sword',item:view.self.swordOffer.choices[0]}});
+  if(view.self.hexOffer)view=await cedarWeb(store,host,'action',{roomId:view.id,round:view.round,revision:view.self.revision,requestId:'actions-hex-'+pack,action:{kind:'pick_hex',hex:view.self.hexOffer.choices[0].id}});
+  if(!view.self.board.length)view=await cedarWeb(store,host,'action',{roomId:view.id,round:view.round,revision:view.self.revision,requestId:'actions-move-'+pack,action:{kind:'move',piece:view.self.bench[0].id,row:0,col:0}});
+  const p={roomId:view.id,round:view.round,revision:view.self.revision,requestId:'actions-ready-'+pack,action:{kind:'ready'}};
+  const result:any=await cedarWeb(store,host,'action',p);const retry:any=await cedarWeb(store,host,'action',p);
+  assert.equal(result.revision,retry.revision);assert(result.battle);assert(result.self.shop.length>0);
+ }
+});
+
+
+test('aggregate completion excludes cancelled rooms and retries; slots deduplicate actors',async t=>{
+ const dir=mkdtempSync(join(tmpdir(),'cedar-stats-'));t.after(()=>rmSync(dir,{force:true,recursive:true}));
+ const store=new RoomStore(dir),host=platformIdentity({playerId:'91',actorType:'human'}),slot=platformIdentity({playerId:'91:2',actorType:'human'});
+ const made:any=await cedarWeb(store,host,'create',{mode:'duel',requestId:'stats-create-1'});
+ const view:any=await cedarWeb(store,host,'start',{roomId:made.roomId,requestId:'stats-start-1'});
+ const action={roomId:made.roomId,round:view.round,revision:view.self.revision,requestId:'stats-resign-1',action:{kind:'resign'}};
+ await cedarWeb(store,host,'action',action);await cedarWeb(store,host,'action',action);
+ const other:any=await cedarWeb(store,slot,'create',{mode:'duel',requestId:'stats-create-2'});
+ const waiting:any=await cedarWeb(store,slot,'state',{roomId:other.roomId});
+ await cedarWeb(store,slot,'action',{roomId:other.roomId,round:waiting.round,revision:waiting.self.revision,requestId:'stats-cancel-2',action:{kind:'cancel_room'}});
+ assert.deepEqual(store.platformStats(Date.now()-3600000,Date.now()+1),{active_humans:1,active_machines:0,created:2,started:1,finished:1});
+ assert.deepEqual(store.platformStats(Date.now()+10,Date.now()+20),{active_humans:0,active_machines:0,created:0,started:0,finished:0});
+});
