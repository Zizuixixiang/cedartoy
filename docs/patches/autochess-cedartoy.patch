new file mode 100644
index 0000000..8814324
--- /dev/null
+++ b/cedartoy/transport.ts
@@ -0,0 +1,29 @@
+export type Scope={slot:number;ai_id?:string;watch?:boolean};
+let scope:Scope={slot:1};
+let generation=0;
+export const scopeKey=()=>generation+':'+JSON.stringify(scope);
+// A generation also rejects responses from A -> B -> A and account changes.
+export const setScope=(next:Scope,reset=false)=>{if(reset||JSON.stringify(next)!==JSON.stringify(scope))generation++;scope={...next};};
+export async function cedarRequest<T=any>(path:string,body:object={}):Promise<T>{
+ const token=localStorage.getItem('cedartoy_token'),identityScope=scopeKey();
+ if(!token)throw Error('请先登录人类账号，再返回棋室');
+ let response:Response;
+ try{response=await fetch('/autochess/api/'+path,{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+token},body:JSON.stringify({...body,...scope}),signal:AbortSignal.timeout(8000),cache:'no-store'});}
+ catch{throw Error('网络中断，棋局仍保留。恢复后可以重连或重试刚才操作。');}
+ const result=await response.json();
+ if(token!==localStorage.getItem('cedartoy_token')||identityScope!==scopeKey())throw Error('账号或存档槽已切换，请重新打开');
+ if(!response.ok)throw Object.assign(Error(result.error||'请求失败'),{status:response.status,retryable:response.status!==403&&!/^(你是房主，请先点|请等待房主开始)/.test(result.error||'')});return result;
+}
+export function roomRequest<T=any>(op:string,args:object={}):Promise<T>{
+ // Original components accept RoomCredentials. Remove their compatibility placeholder here.
+ const {token,accountToken,...game}=args as Record<string,unknown>;
+ return cedarRequest('room',{...game,op});
+}
+export function metaRequest<T=any>(op:string,args:object={}):Promise<T>{
+ const {token,accountToken,...params}=args as Record<string,unknown>;
+ return cedarRequest('economy',{...params,op});
+}
+export function accountRequest<T=any>(op:string,args:object={}):Promise<T>{
+ if(!['wheel','wheel_action'].includes(op))throw Error('请使用当前账号');
+ return metaRequest(op,args);
+}
