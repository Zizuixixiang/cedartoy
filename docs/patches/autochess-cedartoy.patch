+import '../app/globals.css';
+import React,{useEffect,useRef,useState} from 'react';
+import {createRoot} from 'react-dom/client';
+import {RoomApp} from '../components/autochess/room-app';
+import {cedarRequest,roomRequest,setScope} from './transport';
+import './style.css';
+type Room={roomId:string;packName:string;mode:string;phase:string;round:number;seats:number;capacity:number};
+function App(){
+ const [config,setConfig]=useState<any>();const [error,setError]=useState('');const [busy,setBusy]=useState(false);
+ const [slot,setSlot]=useState(1);const [ai,setAI]=useState('');const [selected,setSelected]=useState<string[]>([]);
+ const [pack,setPack]=useState('ai');const [mode,setMode]=useState('standard');const [seats,setSeats]=useState(8);
+ const [room,setRoom]=useState('');const [watch,setWatch]=useState(false);
