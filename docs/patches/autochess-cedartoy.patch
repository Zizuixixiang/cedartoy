+ if(management&&config?.author_stats&&!ai)return <GameStats onBack={()=>setManagement(false)} onDenied={()=>{setManagement(false);setConfig(old=>old?{...old,author_stats:false}:old);setError('未获本游戏统计查看授权');}}/>;
+ if(room)return <RoomApp key={`${room}:${watch}`} cedar initialCredentials={{roomId:room,token:''}} onSessionChange={()=>{resetRoomScope();setRoom('');setWatch(false);void refresh();void metaRequest<{self:SelfAccount}>('profile').then(p=>{if(alive.current)setProfile(p.self);}).catch(()=>{});}}/>;
