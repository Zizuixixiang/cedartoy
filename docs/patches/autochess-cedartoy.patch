+const person=(id:string,actorType:'human'|'ai'='human')=>platformIdentity({playerId:id,actorType}).owner;
+test('trusted one-human one-AI duels auto-start once; crash between create/start recovers on retry',t=>{
+ const dir=mkdtempSync(join(tmpdir(),'cedar-household-start-'));t.after(()=>rmSync(dir,{force:true,recursive:true}));
+ let store=new RoomStore(dir);const host=person('51:2'),ai=person('52:2','ai');
+ for(const pack of ['ai','jianghu']){
+  const key='auto-start-'+pack;
+  const made=store.createForPlatform(host,key,pack,'duel',2,[ai]);
+  const view=()=>store.view(store.accountSeat(made.roomId,host.accountId)!);
+  const initial=view();assert.equal(initial.phase,'prepare');assert.equal(initial.seats.length,2);assert.equal(initial.seats.filter(s=>s.bot).length,0);
+  const raw=JSON.parse(readFileSync(join(dir,made.roomId+'.json'),'utf8'));
+  assert.match(raw.platformStart,/^[a-zA-Z0-9-]{8,80}$/);assert.equal(raw.seats[1].activeAt,undefined);
+  for(let i=0;i<3;i++)assert.equal(store.createForPlatform(host,key,pack,'duel',2,[ai]).roomId,made.roomId);
+  assert.equal(view().revision,initial.revision);
+  store=new RoomStore(dir);assert.equal(store.createForPlatform(host,key,pack,'duel',2,[ai]).roomId,made.roomId);assert.equal(view().revision,initial.revision);
+  const cred=store.accountSeat(made.roomId,host.accountId)!;
+  const ended=store.mutate({...cred,round:view().round,revision:view().self!.revision,requestId:'finish-'+pack,action:{kind:'resign'}});
+  assert.equal(ended.phase,'finished');
+  assert.equal(store.createForPlatform(host,key,pack,'duel',2,[ai]).roomId,made.roomId);
+  assert.equal(view().phase,'finished');assert.equal(view().revision,ended.revision);assert.deepEqual(view().self!.result,ended.self!.result);
+ }
+ const start=store.start;store.start=()=>{throw Error('simulated interrupted start');};
+ assert.throws(()=>store.createForPlatform(host,'interrupted-create','ai','duel',2,[ai]),/interrupted/);
+ store.start=start;
+ const waiting=store.platformRooms(host.accountId).find(r=>r.phase==='waiting')!;assert(waiting);
+ store=new RoomStore(dir);
+ assert.equal(store.createForPlatform(host,'interrupted-create','ai','duel',2,[ai]).roomId,waiting.roomId);
+ assert.equal(store.view(store.accountSeat(waiting.roomId,host.accountId)!).phase,'prepare');
+ assert.equal(store.platformPlayBreakdown(0,Date.now()+1).started,3);
+ assert.equal(store.platformRooms(person('51').accountId).length,0);
+});
+test('solo, friend invitations and other full households keep manual starts',t=>{
+ const dir=mkdtempSync(join(tmpdir(),'cedar-manual-start-'));t.after(()=>rmSync(dir,{force:true,recursive:true}));
+ const store=new RoomStore(dir),host=person('61'),ai=person('62','ai');
+ for(const [key,mode,seats,household] of [['solo-duel','duel',2,[]],['full-standard','standard',2,[ai]],['partial-standard','standard',8,[ai]],['human-duel','duel',2,[person('63')]]] as const){
+  const made=store.createForPlatform(host,key,'ai',mode,seats,[...household]);assert.equal(store.view(store.accountSeat(made.roomId,host.accountId)!).phase,'waiting');
+  if(key==='solo-duel'){store.joinForPlatform(made.invitation,person('64'));assert.equal(store.view(store.accountSeat(made.roomId,host.accountId)!).phase,'waiting');}
