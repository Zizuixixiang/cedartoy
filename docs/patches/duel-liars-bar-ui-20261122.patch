+}
+.liars-bar-avatar img { width: 100%; height: 100%; object-fit: cover; }
+.liars-bar-identity { min-width: 0; }
+.liars-bar-identity strong { display: block; font-size: 15px; }
+.liars-bar-identity small { display: block; font-weight: 500; }
+.liars-bar-roster [aria-current="true"] .liars-bar-identity small { font-weight: 700; color: var(--seat-ink); }
+.liars-bar-meter { display: flex; gap: 2px; margin-top: 3px; }
