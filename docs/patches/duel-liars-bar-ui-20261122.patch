diff --git a/app/static/app.js b/app/static/app.js
index b470d01..995ece6 100644
--- a/app/static/app.js
+++ b/app/static/app.js
@@ -1597,6 +1597,9 @@ function gameTokenEstimateLabel(gameType) {
     chinese_checkers: "约40–200 token/轮",
     dots_boxes: "约30–120 token/轮",
     doudizhu: "约300–600 token/轮",
+    // 2–4 seats, seeds 7/11/37: 353 ordinary state + move pairs, cl100k_base.
+    // Compact root content P10/median/P90 = 64/132/172, excluding the RPC envelope.
+    liars_bar: "约60–180 token/轮",
     liars_dice: "约50–150 token/轮",
     mahjong: "约600–900 token/轮",
     // scripts/sample_ka_wu_xing_mcp.py in CedarToy: seeds 7/11/37, 0 stake,
@@ -1622,6 +1625,10 @@ function updateGameTokenEstimate() {
   if (!label) return;
   const estimate = gameTokenEstimateLabel(selectedGameType($("gameType")));
   label.textContent = estimate ? `（${estimate}）` : "";
+  if (selectedGameType($("gameType")) === "liars_bar") {
+    label.title = "cl100k_base 实测一次 state + move 的压缩响应正文。首次进入、复杂结算另计，不含协议包装、聊天和模型思考。";
+    return;
+  }
   if (selectedGameType($("gameType")) === "ka_wu_xing") {
     label.title = "常见回合参考：默认中位412、全选中位514 token（cl100k_base 实测 state+move 压缩JSON正文）。复杂回合95分位约900–980 token，非上限。首次进入/手动完整同步/终局另计；根工具包装另计（中位约645–798），不含guide/chat/模型思考；不是计费上限。";
     return;
diff --git a/app/static/games/liars_bar.js b/app/static/games/liars_bar.js
index d0c116d..42861ac 100644
--- a/app/static/games/liars_bar.js
+++ b/app/static/games/liars_bar.js
@@ -3,36 +3,114 @@
 
   function element(tag, text, className) {
     const node = document.createElement(tag);
-    if (text) node.textContent = text;
+    if (text != null) node.textContent = text;
     if (className) node.className = className;
     return node;
   }
 
-  function renderBoard({board, room, state, privateState, participants, canMove, helpers, uiState}) {
+  function cardFace(rank) {
+    const face = element("span", rank, "liars-bar-face");
+    const corner = element("small", rank === "Joker" ? "★" : rank);
+    corner.setAttribute("aria-hidden", "true");
+    face.append(corner);
+    if (rank === "Joker") face.classList.add("joker");
+    return face;
+  }
+
+  function playerTable(state, room, participants, viewer, helpers) {
+    const table = element("table", "", "liars-bar-roster");
+    const header = table.createTHead().insertRow();
+    for (const title of ["玩家", "余牌", "已受罚"]) {
+      const cell = element("th", title);
+      cell.scope = "col";
+      header.append(cell);
+    }
+    const body = table.createTBody();
+    for (const p of participants) {
+      const id = p.player_id;
+      const alive = state.alive.includes(id);
+      const current = room.status === "playing" && state.turn_player_id === id;
+      const row = body.insertRow();
+      row.className = `seat-${p.seat_index}`;
+      if (current) row.setAttribute("aria-current", "true");
+      const identity = element("th");
+      identity.scope = "row";
+      const player = element("div", "", "liars-bar-player");
+      const avatar = element("span", "", "liars-bar-avatar");
+      helpers.renderParticipantAvatar(avatar, p);
+      avatar.setAttribute("aria-hidden", "true");
+      const details = element("div", "", "liars-bar-identity");
+      details.append(element("strong", p.display_name || "玩家"));
+      const status = [];
+      if (id === viewer?.player_id) status.push(room.spectating ? "观战视角" : "你");
+      else {
+        const kind = {system_npc: "NPC", bound_machine: "小机", human: "人类"}[p.participant_kind];
+        if (kind && kind !== p.display_name) status.push(kind);
+      }
+      if (room.winner_player_id === id) status.push("获胜");
+      else if (current) status.push("行动中");
+      else if (!alive) status.push(p.join_status === "left" ? "已离席" : "已出局");
+      else if (state.counts[id] === 0) status.push("本轮已出完");
+      if (status.length) details.append(element("small", status.join(" · ")));
+      player.append(avatar, details);
+      identity.append(player);
+      row.append(identity);
+      const remaining = row.insertCell();
+      remaining.append(element("strong", alive ? state.counts[id] : "—"));
+      if (alive) remaining.append(" 张");
+      const risk = row.insertCell();
+      const shots = state.shots[id];
+      risk.append(`${shots} 次`);
+      const meter = element("span", "", "liars-bar-meter");
+      meter.setAttribute("aria-hidden", "true");
+      for (let i = 0; i < 6; i++) {
+        const tick = element("i");
+        if (i < shots) tick.className = "liars-bar-used";
+        meter.append(tick);
+      }
+      risk.append(meter);
+    }
+    return table;
+  }
+
+  function revealedPlay(r, name) {
+    const section = element("section", "", "liars-bar-reveal");
+    const heading = element("div", "", "liars-bar-verdict");
+    heading.append(element("small", `第 ${r.round} 轮摊牌 · 主牌 ${r.target}`),
+      element("strong", r.liar ? "质疑成功" : "质疑失败"));
+    const evidence = element("div", "", "liars-bar-evidence");
+    const hand = element("div");
+    hand.append(element("small", `${name(r.player_id)} 摊开`));
+    const cards = element("div", "", "liars-bar-open-cards");
+    for (const rank of r.cards) cards.append(cardFace(rank));
+    hand.append(cards);
+    const challenger = r.challenger === null ? "系统" : name(r.challenger);
+    const result = r.penalized === null ? "无人受罚" : `${name(r.penalized)}${r.hit ? "受罚出局" : "受罚后幸存"}`;
+    const outcome = element("div", "", "liars-bar-outcome");
+    outcome.append(element("small", `${challenger}质疑 · ${r.liar ? "有假牌" : "全真"}`), element("strong", result));
+    evidence.append(hand, outcome);
+    section.append(heading, evidence);
+    return section;
+  }
+
+  function renderBoard({board, room, state, privateState, participants, viewer, canMove, helpers, uiState}) {
     if (!state.round) return;
     const name = id => participants.find(p => p.player_id === id)?.display_name || "玩家";
-    const panel = element("section", "", "liars-current-round liars-bar-table");
-    const heading = element("div", "", "liars-round-heading");
-    heading.append(element("strong", `第 ${state.round} 轮 · 主牌 ${state.target}`));
+    const panel = element("section", "", "liars-bar-table");
+    const heading = element("header", "", "liars-bar-heading");
+    heading.append(element("b", state.target, "liars-bar-trump"), element("strong", "主牌"),
+      element("small", `第 ${state.round} 轮`));
     panel.append(heading);
     if (state.claim) {
-      panel.append(element("p", `${name(state.claim.player_id)} 暗出了 ${state.claim.count} 张`));
-    }
-    for (const p of participants) {
-      const id = p.player_id;
-      const status = state.alive.includes(id) ? `余牌 ${state.counts[id]} 张` : "已出局";
-      panel.append(element("p", `${name(id)} · ${status} · 已受罚 ${state.shots[id]} 次`));
+      const claim = element("div", "", "liars-bar-claim");
+      const count = element("span", "", "liars-bar-count");
+      count.append("暗出 ", element("b", state.claim.count), " 张");
+      claim.append(element("small", "上一手"), element("strong", name(state.claim.player_id)), count);
+      panel.append(claim);
     }
+    panel.append(playerTable(state, room, participants, viewer, helpers));
     board.append(panel);
-    if (state.reveal) {
-      const r = state.reveal;
-      const who = r.challenger === null ? "系统" : name(r.challenger);
-      const outcome = r.penalized === null ? "无人受罚" : `${name(r.penalized)}${r.hit ? "淘汰" : "受罚后幸存"}`;
-      const reveal = element("section", "", "liars-current-round liars-bar-table");
-      reveal.append(element("strong", `第 ${r.round} 轮摊牌 · 主牌 ${r.target}`),
-        element("p", `${who}质疑${name(r.player_id)}，摊开 ${r.cards.join("、")}。${r.liar ? "有假牌" : "全真"}，${outcome}。`));
-      board.append(reveal);
-    }
+    if (state.reveal) board.append(revealedPlay(state.reveal, name));
 
     const hand = privateState?.hand || [];
     if (room.spectating || !hand.length) return;
@@ -49,11 +127,7 @@
       uiState.cardIndexes = [...selected];
     }
     hand.forEach((rank, index) => {
-      const face = element("span", rank, "liars-bar-face");
-      const corner = element("small", rank === "Joker" ? "★" : rank);
-      corner.setAttribute("aria-hidden", "true");
-      face.append(corner);
-      if (rank === "Joker") face.classList.add("joker");
+      const face = cardFace(rank);
       if (!selectable) {
         field.append(face);
         return;
@@ -93,6 +167,8 @@
   window.DuelGameUI.register("liars_bar", {
     usesStandardMoveConfirmation: false,
     ownsPrivateStatePresentation: true,
+    participantPresentation: "embedded",
+    multiplayerTable: true,
     renderBoard,
   });
 }());
