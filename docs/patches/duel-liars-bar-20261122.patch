diff --git a/tests/test_liars_bar.py b/tests/test_liars_bar.py
new file mode 100644
index 0000000..5a778ba
--- /dev/null
+++ b/tests/test_liars_bar.py
@@ -0,0 +1,322 @@
+from collections import Counter
+from copy import deepcopy
+import json
+import os
+import random
+import subprocess
+import sys
+import unittest
+from unittest.mock import patch
+
+from app import database, framework, invites, mcp_minimal, npc_controller, takeover
+from app.games import GAMES
+from app.games.liars_bar import LiarsBar
+from tests.full_state_support import isolated_scenario_database
+
+
+def seats(count):
+    return [dict(player_id=f"p{i}", role="ai", participant_kind="bound_machine",
+                 display_name=f"玩家{i}") for i in range(count)]
+
+
+class Rules(unittest.TestCase):
+    def setUp(self):
+        self.game = LiarsBar(random.Random(17))
+        self.state = self.game.initialize(seats(3))
+        self.state.update(target="A", turn_player_id="p0")
+        self.state["chambers"] = dict.fromkeys(self.state["alive"], 5)
+
+    def act(self, action, **args):
+        player = {"player_id": self.state["turn_player_id"]}
+        result = self.game.apply_action(self.state, dict(action=action, **args), player)
+        self.state = result.state
+        return result
+
+    def test_deal_and_random_openers(self):
+        openers = set()
+        targets = set()
+        for i in range(72):
+            n = 2 + i % 3
+            state = self.game.initialize(seats(n))
+            cards = Counter(card for hand in state["hands"].values() for card in hand)
+            self.assertEqual([len(h) for h in state["hands"].values()], [5] * n)
+            deck = Counter(A=6, K=6, Q=6, Joker=2)
+            self.assertLessEqual(cards, deck)
+            if n == 4:
+                self.assertEqual(cards, deck)
+                openers.add(state["turn_player_id"])
+            targets.add(state["target"])
+            self.assertTrue(all(0 <= x < 6 for x in state["chambers"].values()))
+        self.assertEqual(openers, {"p0", "p1", "p2", "p3"})
+        self.assertEqual(targets, {"A", "K", "Q"})
+
+    def test_truth_joker_mixed_lie_and_penalty_starter(self):
+        initial = deepcopy(self.state)
+        for cards, loser in [(["A", "Joker"], "p1"), (["Joker"], "p1"), (["A", "K"], "p0")]:
+            self.state = deepcopy(initial)
+            self.state["hands"]["p0"] = cards + ["Q"]
+            self.act("play", cards=cards)
+            self.act("challenge")
+            self.assertEqual(self.state["reveal"]["cards"], cards)
+            self.assertEqual(self.state["reveal"]["penalized"], loser)
+            self.assertEqual(self.state["turn_player_id"], loser)
+            self.assertEqual(self.state["shots"][loser], 1)
+            self.assertEqual(self.state["round"], 2)
+            self.assertEqual(self.state["chambers"], initial["chambers"])
+            self.assertIsNone(self.state["pending"])
+
+    def test_each_chamber_advances_once_and_only_past_results_are_public(self):
+        for position in range(6):
+            state = self.game.initialize(seats(2))
+            state["chambers"]["p0"] = position
+            for prior in range(position + 1):
+                state.update(target="A", turn_player_id="p0")
+                state["hands"]["p0"] = ["Q"]
+                self.state = state
+                self.act("play", cards=["Q"])
+                public = self.game.public_state(self.state, [])
+                private = self.game.private_state(self.state, {"player_id": "p1"}, [])
+                alternate = deepcopy(self.state)
+                alternate["chambers"]["p0"] = (position + 1) % 6
+                alternate["pending"]["cards"] = ["A"]
+                self.assertEqual(public, self.game.public_state(alternate, []))
+                self.assertEqual(private, self.game.private_state(alternate, {"player_id": "p1"}, []))
+                outcome = self.act("challenge")
+                state = outcome.state
+                self.assertEqual(state["shots"]["p0"], prior + 1)
+                self.assertEqual(bool(outcome.participant_activity), prior == position)
+                self.assertEqual(state["reveal"]["hit"], prior == position)
+            self.assertEqual(state["winner_player_id"], "p1")
+            self.assertEqual(state["round"], position + 1)
+            self.assertEqual(state["alive"], ["p1"])
+            self.assertIsNone(state["turn_player_id"])
+
+    def test_skip_empty_and_eliminated_wrap_to_next_alive(self):
+        self.state["hands"].update(p0=["K"], p1=[], p2=["Joker"])
+        self.state["chambers"]["p0"] = 0
+        self.act("play", cards=["K"])
+        self.assertEqual(self.state["turn_player_id"], "p2")
+        self.act("challenge")
+        self.assertEqual(self.state["turn_player_id"], "p1")
+        self.assertEqual(set(self.state["hands"]), {"p1", "p2"})
+        self.state.update(turn_player_id="p2")
+        self.act("play", cards=self.state["hands"]["p2"][:1])
+        self.assertEqual(self.state["turn_player_id"], "p1")
+
+    def test_last_hand_may_challenge_or_accept_system_reveal(self):
+        for hand, loser in [(["A"] * 4 + ["Joker"], None), (["A"] * 3 + ["K"], "p1")]:
+            self.state["hands"].update(p0=["K"], p1=hand, p2=[])
+            self.state.update(target="A", turn_player_id="p0", pending=None)
+            self.act("play", cards=["K"])
+            waiting = deepcopy(self.state)
+            self.assertEqual(self.game.private_state(waiting, {"player_id": "p1"}, [])["actions"],
+                             ["accept", "challenge"])
+            with self.assertRaises(ValueError):
+                self.act("play", cards=["A"])
+            self.act("challenge")
+            self.assertEqual(self.state["reveal"]["penalized"], "p0")
+            self.state = waiting
+            previous = self.state["shots"].copy()
+            self.act("accept")
+            self.assertEqual(self.state["reveal"]["cards"], hand)
+            self.assertIsNone(self.state["reveal"]["challenger"])
+            self.assertEqual(self.state["reveal"]["penalized"], loser)
+            if loser is None:
+                self.assertEqual(self.state["shots"], previous)
+            self.assertIn(self.state["turn_player_id"], self.state["alive"])
+
+    def test_responder_forfeits_without_self_challenge(self):
+        self.state["hands"] = {"p0":["A", "K"], "p1":["Q"], "p2":[]}
+        self.act("play", cards=["A"])
+        self.game.apply_resignation(self.state, "p1", seats(3))
+        self.assertEqual(self.state["round"], 2)
+        self.assertIsNone(self.state["pending"])
+        self.assertEqual(self.state["alive"], ["p0", "p2"])
+        self.assertEqual(self.state["turn_player_id"], "p0")
+        self.assertEqual(self.state["shots"], dict.fromkeys(["p0", "p1", "p2"], 0))
+
+    def test_invalid_actions_are_atomic(self):
+        self.state["hands"]["p0"] = ["A", "A", "K"]
+        previous = deepcopy(self.state)
+        for move in ({"action": "challenge"}, {"action": "accept"}, {"action": "play", "cards": "A"},
+                     *({"action": "play", "cards": v} for v in ([], ["K","K"], ["A"] * 4, ["Q"], [{}])),
+                     {"action": "play", "cards": ["A"], "player_id": "p1"}):
+            with self.assertRaises(ValueError):
+                self.game.apply_action(self.state, move, {"player_id": "p0"})
+        self.assertEqual(self.state, previous)
+
+    def test_local_choice_is_independent_of_concealed_cards_and_chambers(self):
+        self.state["hands"].update(p0=["A", "Q"], p1=["K", "A"], p2=["A"])
+        self.act("play", cards=["A"])
+        other = deepcopy(self.state)
+        other["pending"]["cards"] = ["K"]
+        other["hands"]["p0"] = ["Joker"]
+        other["hands"]["p2"] = ["Q"]
+        other["chambers"]["p1"] = 0
+        for seed in range(12):
+            actor = {"player_id": "p1"}
+            observed = LiarsBar(random.Random(seed)).choose_local_npc_action(self.state, actor, seats(3))
+            self.assertEqual(observed, LiarsBar(random.Random(seed)).choose_local_npc_action(other, actor, seats(3)))
+
+    def test_local_games_reach_one_winner(self):
+        for n in (2, 3, 4):
+            people = seats(n)
+            for _ in range(12):
+                state = self.game.initialize(people)
+                for turn in range(300):
+                    actor = {"player_id": state["turn_player_id"]}
+                    action = self.game.choose_local_npc_action(state, actor, people)
+                    state = self.game.apply_action(state, action, actor).state
+                    if self.game.result_for(state, people):
+                        break
+                self.assertEqual(state["alive"], [state["winner_player_id"]])
+
