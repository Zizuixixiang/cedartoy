+++ b/app/games/liars_bar.py
@@ -0,0 +1,236 @@
+"""Standard Liar's Deck adapted from LYiHub/liars-bar-llm (Apache-2.0).
+
+CedarToy adaptation: seat-based room transitions, local NPC actions and
+viewer-scoped state. See third_party/liars-bar-llm/LICENSE.
+"""
+from copy import deepcopy
+from itertools import combinations
+from random import SystemRandom
+
+from .base import GamePlugin, MoveResult
+from .mcp_incremental import changed
+
+RANKS = ("A", "K", "Q")
+DECK = RANKS * 6 + ("Joker",) * 2
+
+
+class LiarsBar(GamePlugin):
+    game_type = "liars_bar"
+    display_name = "骗子酒馆"
+    category = "tabletop"
+    max_players = recommended_players = 4
+    supports_npcs = uses_local_npc_strategy = True
+    mcp_event_key = "liars_bar_delta"
+    rules_text = (
+        "【牌桌】\nA、K、Q 各 6 张，Joker 2 张。每轮重洗，每位存活玩家发 5 张，随机公布主牌。首轮随机先手。\n\n"
+        "【暗出与质疑】\n暗出 1–3 张，声称全是主牌；Joker 当主牌。顺座跳过淘汰和空手者，"
+        "下家可以质疑，或放过并出牌。仅剩自己有牌时仍可质疑上一手；放过即由系统摊验自己的全部余牌。\n\n"
+        "【结算】\n有假牌则出牌者受罚，全真则质疑者受罚（系统质疑失败无人受罚）。"
+        "每人六个虚拟弹膛中一格命中，每次依次检查一格，跨轮保留。命中淘汰，最后一人获胜。"
+        "受罚者存活先手，淘汰则顺延；无人受罚随机先手。"
+    )
+    mcp_rules = ("A/K/Q 各6、Joker 2。每轮存活者各5张，主牌随机。暗出1–3张，主牌和Joker为真。"
+                 "顺座跳过空手和淘汰者。质疑遇假罚出牌者，全真罚质疑者。仅自己有牌时放过即摊验全部余牌，全真无人受罚。"
+                 "每人6膛1中，跨轮逐格受罚。命中淘汰，独活获胜。幸存受罚者下轮先手，淘汰则顺延，首轮或无人受罚随机。")
+    move_format = 'params.move={"action":"play","cards":["K","Joker"]}、{"action":"challenge"} 或 {"action":"accept"}（放过并摊验余牌）。'
+
+    def __init__(self, rng=None):
+        self._rng = rng or SystemRandom()
+
+    def initial_state(self):
+        return self.initialize([{"player_id": "X"}, {"player_id": "O"}])
+
+    def initialize(self, participants):
+        order = [p["player_id"] for p in participants]
+        state = {
+            "order": order,
+            "alive": [p["player_id"] for p in participants if p.get("active", True)],
+            "shots": dict.fromkeys(order, 0),
+            "chambers": {pid: self._rng.randrange(6) for pid in order},
+            "round": 0, "reveal": None, "winner_player_id": None,
+        }
+        self._deal(state, self._rng.choice(state["alive"]))
+        return state
+
+    def resolve_opening_player_id(self, state, proposed_player_id, participants):
+        return state["turn_player_id"]
+
+    def _deal(self, state, first):
+        deck = list(DECK)
+        self._rng.shuffle(deck)
+        hands = {pid: [] for pid in state["alive"]}
+        for _ in range(5):
+            for hand in hands.values():
+                hand.append(deck.pop())
+        state.update(round=state["round"] + 1, hands=hands, target=self._rng.choice(RANKS),
+                     pending=None, turn_player_id=first)
+
+    @staticmethod
+    def _last_hand(state, pid):
+        return all(not hand for other, hand in state["hands"].items() if other != pid)
+
+    @staticmethod
+    def _next(state, pid, *, with_cards):
+        order = state["order"]
+        start = order.index(pid)
+        return next(other for other in order[start + 1:] + order[:start + 1]
+                    if other in state["alive"] and (not with_cards or state["hands"][other]))
+
+    def validate_action(self, state, move, actor):
+        pid = actor["player_id"]
+        if state["turn_player_id"] != pid or pid not in state["alive"]:
+            raise ValueError("当前不能行动")
+        if move == {"action": "challenge"} and state["pending"]:
+            return
+        if self._last_hand(state, pid):
+            if state["pending"] and move == {"action": "accept"}:
+                return
+            raise ValueError("请选择质疑上一手或放过并摊验余牌")
+        if set(move) != {"action", "cards"} or move["action"] != "play":
+            raise ValueError("请选择暗出手牌或质疑上一手")
+        cards = move["cards"]
+        if not isinstance(cards, list) or not 1 <= len(cards) <= 3:
+            raise ValueError("每次暗出 1–3 张")
+        remaining = state["hands"][pid].copy()
+        for card in cards:
+            if card not in remaining:
+                raise ValueError("所选牌不在你的手牌中")
+            remaining.remove(card)
+
+    def apply_action(self, state, move, actor):
+        self.validate_action(state, move, actor)
+        before = self.public_state(state, [])
+        state = deepcopy(state)
+        pid = actor["player_id"]
+        activity = {}
+        note = ""
+        if move["action"] == "play":
+            for card in move["cards"]:
+                state["hands"][pid].remove(card)
+            state["pending"] = {"player_id": pid, "cards": move["cards"].copy()}
+            state["turn_player_id"] = self._next(state, pid, with_cards=True)
+        else:
+            system = move["action"] == "accept"
+            claim = {"player_id": pid, "cards": state["hands"][pid].copy()} if system else state["pending"]
+            liar = any(card not in (state["target"], "Joker") for card in claim["cards"])
+            penalized = claim["player_id"] if liar else (None if system else pid)
+            hit = False
+            if penalized is not None:
+                hit = state["shots"][penalized] == state["chambers"][penalized]
+                state["shots"][penalized] += 1
+                if hit:
+                    state["alive"].remove(penalized)
+                    state["hands"].pop(penalized)
+                    activity[penalized] = "eliminated"
+            state["reveal"] = {
+                **claim, "target": state["target"], "round": state["round"],
+                "challenger": None if system else pid, "liar": liar,
+                "penalized": penalized, "hit": hit,
+            }
+            verdict = "有假牌" if liar else "全真"
+            outcome = "无人受罚" if penalized is None else ("受罚者淘汰" if hit else "受罚者幸存")
+            note = f"第 {state['round']} 轮摊牌 {'、'.join(claim['cards'])}，{verdict}，{outcome}。"
+            state["pending"] = None
+            if system and pid in state["hands"]:
+                state["hands"][pid].clear()
+            if len(state["alive"]) == 1:
+                state.update(winner_player_id=state["alive"][0], turn_player_id=None)
+            else:
+                if penalized is None:
+                    first = self._rng.choice(state["alive"])
+                elif hit:
+                    first = self._next(state, penalized, with_cards=False)
+                else:
+                    first = penalized
+                self._deal(state, first)
+        public_move = {"action": move["action"]}
+        if move["action"] == "play":
+            public_move["count"] = len(move["cards"])
+        return MoveResult(state, next_player_id=state["turn_player_id"], turn_completed=True,
+                          participant_activity=activity, public_move=public_move, note=note,
+                          public_event={self.mcp_event_key: changed(self.public_state(state, []), before)})
+
+    def apply_resignation(self, state, resigned_player_id, participants):
+        if resigned_player_id not in state["alive"]:
+            return
+        state["alive"].remove(resigned_player_id)
+        state["hands"].pop(resigned_player_id)
+        if len(state["alive"]) == 1:
+            state.update(winner_player_id=state["alive"][0], turn_player_id=None, pending=None)
+            return
+        claimant = (state["pending"] or {}).get("player_id")
+        if claimant == resigned_player_id or not any(state["hands"].values()):
+            self._deal(state, self._next(state, resigned_player_id, with_cards=False))
+        elif state["turn_player_id"] == resigned_player_id:
+            responder = self._next(state, resigned_player_id, with_cards=True)
+            if responder == claimant:
+                # No one left can challenge this claim; never ask a seat to challenge itself.
+                self._deal(state, responder)
+            else:
+                state["turn_player_id"] = responder
+
+    def public_state(self, state, participants):
+        claim = state["pending"]
+        return {"round": state["round"], "target": state["target"], "alive": state["alive"].copy(),
+                "counts": {pid: len(hand) for pid, hand in state["hands"].items()},
+                "shots": state["shots"].copy(), "turn_player_id": state["turn_player_id"],
+                "claim": {"player_id": claim["player_id"], "count": len(claim["cards"])} if claim else None,
+                "reveal": deepcopy(state["reveal"])}
+
+    @staticmethod
+    def mcp_event(event, previous):
+        # Waiting-room legacy reads may deliver chat before the v2 bootstrap.
+        return event
+
+    def private_state(self, state, viewer, participants):
+        pid = viewer["player_id"]
+        hand = state["hands"].get(pid, []).copy()
+        actions = []
+        if hand and pid == state["turn_player_id"] and len(state["alive"]) > 1:
+            actions.append("accept" if self._last_hand(state, pid) else "play")
+            if state["pending"]:
+                actions.append("challenge")
+        return {"hand": hand, "actions": actions}
+
+    def npc_legal_actions(self, state, actor, participants):
+        pid = actor["player_id"]
+        if pid != state["turn_player_id"] or pid not in state["alive"]:
+            return []
+        actions = [{"action": "challenge"}] if state["pending"] else []
+        if self._last_hand(state, pid):
+            return actions + [{"action": "accept"}]
+        hand = sorted(state["hands"][pid])
+        for count in range(1, 4):
+            actions.extend({"action": "play", "cards": list(cards)}
+                           for cards in dict.fromkeys(combinations(hand, count)))
+        return actions
+
+    def choose_local_npc_action(self, state, actor, participants):
+        actions = self.npc_legal_actions(state, actor, participants)
+        if state["pending"]:
+            claimant = state["pending"]["player_id"]
+            # A local-only sequence resolves a penalty at least every two turns.
+            if any(p["player_id"] == claimant and p.get("participant_kind") == "system_npc"
+                   for p in participants) or self._rng.randrange(3) == 0:
+                return {"action": "challenge"}
+            actions = [a for a in actions if a["action"] != "challenge"]
+        return self._rng.choice(actions)
+
+    def format_action(self, state, move, actor):
+        if move.get("action") == "play" and isinstance(move.get("cards"), list):
+            return f"暗出 {len(move['cards'])} 张"
+        return "质疑上一手" if move.get("action") == "challenge" else "放过，系统摊验余牌"
+
+    def result_for(self, state, participants):
+        if state["winner_player_id"] is not None:
+            return {"winner_player_id": state["winner_player_id"], "draw": False}
+        return None
+
+    def check_winner(self, state):
+        return state["winner_player_id"]
+
+    def validate_move(self, state, move, mark):
+        self.validate_action(state, move, {"player_id": mark})
+
+    def apply_move(self, state, move, mark):
+        return self.apply_action(state, move, {"player_id": mark})
