diff --git a/app/static/games/liars_bar.js b/app/static/games/liars_bar.js
new file mode 100644
index 0000000..d0c116d
--- /dev/null
+++ b/app/static/games/liars_bar.js
@@ -0,0 +1,98 @@
+(function () {
+  "use strict";
+
+  function element(tag, text, className) {
+    const node = document.createElement(tag);
+    if (text) node.textContent = text;
+    if (className) node.className = className;
+    return node;
+  }
+
+  function renderBoard({board, room, state, privateState, participants, canMove, helpers, uiState}) {
+    if (!state.round) return;
+    const name = id => participants.find(p => p.player_id === id)?.display_name || "玩家";
+    const panel = element("section", "", "liars-current-round liars-bar-table");
+    const heading = element("div", "", "liars-round-heading");
+    heading.append(element("strong", `第 ${state.round} 轮 · 主牌 ${state.target}`));
+    panel.append(heading);
+    if (state.claim) {
+      panel.append(element("p", `${name(state.claim.player_id)} 暗出了 ${state.claim.count} 张`));
+    }
+    for (const p of participants) {
+      const id = p.player_id;
+      const status = state.alive.includes(id) ? `余牌 ${state.counts[id]} 张` : "已出局";
+      panel.append(element("p", `${name(id)} · ${status} · 已受罚 ${state.shots[id]} 次`));
+    }
+    board.append(panel);
+    if (state.reveal) {
+      const r = state.reveal;
+      const who = r.challenger === null ? "系统" : name(r.challenger);
+      const outcome = r.penalized === null ? "无人受罚" : `${name(r.penalized)}${r.hit ? "淘汰" : "受罚后幸存"}`;
+      const reveal = element("section", "", "liars-current-round liars-bar-table");
+      reveal.append(element("strong", `第 ${r.round} 轮摊牌 · 主牌 ${r.target}`),
+        element("p", `${who}质疑${name(r.player_id)}，摊开 ${r.cards.join("、")}。${r.liar ? "有假牌" : "全真"}，${outcome}。`));
+      board.append(reveal);
+    }
+
+    const hand = privateState?.hand || [];
+    if (room.spectating || !hand.length) return;
+    const field = element("fieldset", "", "liars-bar-hand");
+    const actions = canMove ? (privateState.actions || []) : [];
+    const selectable = actions.includes("play");
+    field.append(element("legend", selectable ? "你的手牌 · 选 1–3 张" : "你的手牌"));
+    const selected = new Set(uiState.cardIndexes || []);
+    const checkboxes = [];
+    const play = element("button", "暗出所选牌", "pixel-btn");
+    function syncSelection() {
+      play.disabled = !selected.size;
+      checkboxes.forEach(box => { box.disabled = !box.checked && selected.size >= 3; });
+      uiState.cardIndexes = [...selected];
+    }
+    hand.forEach((rank, index) => {
+      const face = element("span", rank, "liars-bar-face");
+      const corner = element("small", rank === "Joker" ? "★" : rank);
+      corner.setAttribute("aria-hidden", "true");
+      face.append(corner);
+      if (rank === "Joker") face.classList.add("joker");
+      if (!selectable) {
+        field.append(face);
+        return;
+      }
+      const label = element("label");
+      const box = element("input");
+      box.type = "checkbox";
+      box.setAttribute("aria-label", `第 ${index + 1} 张，${rank}`);
+      box.checked = selected.has(index);
+      box.addEventListener("change", () => {
+        if (box.checked) selected.add(index);
+        else selected.delete(index);
+        syncSelection();
+      });
+      label.append(box, face);
+      field.append(label);
+      checkboxes.push(box);
+    });
+    board.append(field);
+    const buttons = element("div", "", "liars-bar-buttons");
+    if (selectable) {
+      syncSelection();
+      play.type = "button";
+      play.onclick = () => helpers.submitMove({action: "play", cards: [...selected].map(i => hand[i])});
+      buttons.append(play);
+    }
+    for (const [action, label] of [["challenge", "质疑上一手"], ["accept", "放过并摊验余牌"]]) {
+      if (!actions.includes(action)) continue;
+      const button = element("button", label, action === "accept" ? "pixel-btn" : "pixel-btn secondary");
+      button.type = "button";
+      button.onclick = () => helpers.submitMove({action});
+      buttons.append(button);
+    }
+    if (buttons.childElementCount) board.append(buttons);
+  }
+
+  window.DuelGameUI.register("liars_bar", {
+    usesStandardMoveConfirmation: false,
+    ownsPrivateStatePresentation: true,
+    renderBoard,
+  });
+}());
