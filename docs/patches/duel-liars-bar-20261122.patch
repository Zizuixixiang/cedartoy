+class Rooms(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        scratch = isolated_scenario_database()
+        scratch.__enter__()
+        self.addCleanup(scratch.__exit__, None, None, None)
+        self.game = LiarsBar(random.Random(11))
+        plugin = patch.dict(GAMES, liars_bar=self.game)
+        plugin.start()
+        self.addCleanup(plugin.stop)
+
+    def ordinary(self, people):
+        return framework.create_room("liars_bar", "ai_first", "ai", "p0",
+                                     ordered_participants=people, require_confirmations=False)
+
+    def play(self, room, move):
+        return framework.play_move(room["room_id"], "ai", room["current_player_id"],
+                                   move, expected_revision=room["revision"])
+
+    def test_incremental_projection_privacy_chat_and_resync(self):
+        room = self.ordinary(seats(3))
+        rid = room["room_id"]
+        actor = room["current_player_id"]
+        viewer = self.game._next(room["board_state"], actor, with_cards=True)
+        initial = mcp_minimal.response(rid, viewer)["room"]
+        board = initial["board_state"]
+        self.assertEqual(initial["private_state"]["hand"], room["board_state"]["hands"][viewer])
+        move = {"action": "play", "cards": room["board_state"]["hands"][actor][:2]}
+        framework.post_message(rid, "ai", actor, "一起玩")
+        room = self.play(room, move)
+        wire = mcp_minimal.response(rid, viewer)
+        self.assertIn({"actor": actor, "message": "一起玩"}, wire["events"])
+        action = next(e for e in wire["events"] if isinstance(e, list))
+        self.assertEqual(action[:2], [actor, "play"])
+        _, _, count, next_player = action
+        self.assertEqual(count, 2)
+        board["counts"][actor] -= count
+        board.update(claim={"player_id":actor, "count":count}, turn_player_id=next_player)
+        self.assertEqual(board, self.game.public_state(room["board_state"], []))
+        for event in framework.list_timeline(rid):
+            if event["event_type"] == "move":
+                self.assertEqual(event["move"], {"action": "play", "count": 2})
+        for hidden in ('"hands"', '"cards"', '"chambers"', '"pending"'):
+            self.assertNotIn(hidden, json.dumps(wire))
+        self.assertNotIn("events", mcp_minimal.response(rid, viewer))
+        with self.assertRaises(framework.DuelError):
+            framework.play_move(rid, "ai", actor, {"action": "challenge"}, expected_revision=room["revision"])
+        with self.assertRaises(framework.DuelError):
+            framework.play_move(rid, "ai", viewer, {"action": "challenge"}, expected_revision=room["revision"] - 1)
+        room = self.play(room, {"action": "challenge"})
+        wire = mcp_minimal.response(rid, viewer)
+        reveal = wire["events"][0][2]["reveal"]
+        self.assertEqual(reveal["cards"], move["cards"])
+        full = mcp_minimal.response(rid, viewer, full=True)["snapshot"]
+        self.assertEqual(full["board_state"], self.game.public_state(room["board_state"], []))
+        self.assertEqual(full["private_state"], self.game.private_state(room["board_state"], {"player_id": viewer}, []))
+        self.assertNotIn("chambers", json.dumps(full))
+        self.assertNotIn("events", mcp_minimal.response(rid, viewer))
+
+    def test_multi_round_cursor_replays_public_actions_once(self):
+        room = self.ordinary(seats(4))
+        rid = room["room_id"]
+        viewer = "p0"
+        initial = mcp_minimal.response(rid, viewer)["room"]
+        board, private = initial["board_state"], initial["private_state"]
+        for turn in range(12):
+            actor = room["current_player_id"]
+            move = ({"action":"challenge"} if turn % 3 == 2 else
+                    {"action":"play", "cards":room["board_state"]["hands"][actor][:1]})
+            room = self.play(room, move)
+            if turn % 3 != 2:
+                continue  # Three actions can arrive in a single state reply.
+            wire = mcp_minimal.response(rid, viewer)
+            self.assertEqual(len(wire["events"]), 3)
+            for actor, action, *fields in wire["events"]:
+                if action == "play":
+                    count, next_player = fields
+                    board["counts"][actor] -= count
+                    board.update(claim={"player_id":actor, "count":count}, turn_player_id=next_player)
+                else:
+                    patch, = fields
+                    self.assertEqual(set(patch["reveal"]).intersection({"cards", "hands", "chambers"}), {"cards"})
+                    board["shots"].update(patch.pop("shots", {}))
+                    if patch.get("counts") == 5:
+                        patch["counts"] = dict.fromkeys(patch.get("alive", board["alive"]), 5)
+                    board.update(patch)
+            private.update(wire.get("private", {}))
+            self.assertEqual(board, self.game.public_state(room["board_state"], []))
+            self.assertEqual(private, self.game.private_state(room["board_state"], {"player_id":viewer}, []))
+            self.assertTrue(set(wire.get("private", {})) <= {"hand", "actions"})
+            self.assertTrue({"events", "private"}.isdisjoint(mcp_minimal.response(rid, viewer)))
+            if room["status"] != "playing":
+                break
+
+    async def test_real_npc_runner_finishes_after_last_machine_is_eliminated(self):
+        people = seats(4)
+        for i, p in enumerate(people[1:], 1):
+            p.update(participant_kind="system_npc", npc_persona_id=f"test{i}")
+        room = self.ordinary(people)
+        state = room["board_state"]
+        state.update(target="A", turn_player_id="p0")
+        state["hands"]["p0"] = ["K"]
+        state["chambers"]["p0"] = 0
+        with database.write_transaction() as conn:
+            conn.execute("UPDATE rooms SET board_state=?,current_player_id='p0' WHERE room_id=?",
+                         (json.dumps(state), room["room_id"]))
+        room = self.play(framework.get_room(room["room_id"]), {"action": "play", "cards": ["K"]})
+        room = self.play(room, {"action": "challenge"})
+        self.assertEqual(room["status"], "playing")
+        with patch.object(npc_controller, "get_npc_provider", side_effect=AssertionError("external call")):
+            for _ in range(50):
+                result = await npc_controller.run_current_npc_turn(room["room_id"])
+                self.assertEqual(result.source, "local")
+                self.assertIsNone(result.speech_task)
+                room = result.room
+                if room["status"] == "finished":
+                    break
+        self.assertIn(room["winner_player_id"], ("p1","p2","p3"))
+        self.assertEqual(room["board_state"]["alive"], [room["winner_player_id"]])
+
+    async def test_invite_and_takeover(self):
+        room = invites.create_invite("liars_bar", "ai", "p0", target_player_count=4, timeout_takeover_seconds=90)
+        for p in seats(4)[1:]:
+            invites.join_invite(room["invite_code"], "ai", p["player_id"])
+        room = invites.start_invite(room["room_id"], "ai", "p0")
+        actor = next(p for p in room["participants"] if p["player_id"] == room["current_player_id"])
+        action = self.game.choose_local_npc_action(room["board_state"], actor, room["participants"])
+        self.assertIn(action, takeover.timeout_legal_actions(room, actor))
+        with patch.object(takeover, "is_due", return_value=True), patch.object(
+            takeover, "get_npc_provider", side_effect=AssertionError("external call")
+        ):
+            updated = await takeover.run_timeout_turn(room["room_id"])
+        self.assertEqual(updated["revision"], room["revision"] + 1)
+
+    def test_cross_process_restore_and_challenge(self):
+        room = self.ordinary(seats(2))
+        actor = room["current_player_id"]
+        room = self.play(room, {"action": "play", "cards": room["board_state"]["hands"][actor][:1]})
+        code = """import json, sys
+from app import framework
+room = framework.get_room(sys.argv[1])
+next_room = framework.play_move(sys.argv[1], 'ai', room['current_player_id'], {'action':'challenge'},
+                                expected_revision=room['revision'])
+print(json.dumps([room['board_state'],next_room['revision']]))"""
+        env = {**os.environ, "DUEL_DB_PATH": str(database.DB_PATH)}
+        output = subprocess.check_output([sys.executable, "-c", code, room["room_id"]], env=env, text=True, timeout=20)
+        restored, revision = json.loads(output)
+        self.assertEqual(restored, room["board_state"])
+        self.assertEqual(revision, room["revision"] + 1)
