[
  {
    "name": "open_door",
    "description": "Open the door.  No arg = random landing; pass a place name or bookmark name.\nblind=True: hide place name (guess to reveal).\nkey=\"...\": deterministic landing by key (same key = same place).\nintent biases what you see (e.g. \"后 boosts food, \"孤独\" boosts quiet).\nAppend \" 斯 to place name (e.g. \"拉萨 斯) to force a fresh landing,\ncreating a new journey even if one already exists for that place.",
    "source": "upstream_mcp",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blind": {
          "type": "boolean",
          "default": false
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "platformParameters": {
