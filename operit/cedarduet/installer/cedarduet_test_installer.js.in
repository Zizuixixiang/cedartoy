/* METADATA
{
  "name": "__CEDARDUET_INSTALLER_PACKAGE_NAME__",
  "display_name": {
    "zh": "CedarDuet 测试安装器",
    "en": "CedarDuet Test Installer"
  },
  "description": {
    "zh": "从 Operit 包管理的 + 导入后，调用 install_cedarduet_test 即可安装并启用内嵌的 CedarDuet ToolPkg 测试版。",
    "en": "Import with the + button in Operit Package Manager, then call install_cedarduet_test to install and enable the embedded CedarDuet ToolPkg test build."
  },
  "enabledByDefault": true,
  "category": "Utility",
  "tools": [
    {
      "name": "install_cedarduet_test",
      "description": {
        "zh": "安装或覆盖安装内嵌的 CedarDuet ToolPkg 测试版，并启用 cedarduet 子包。",
        "en": "Install or replace the embedded CedarDuet ToolPkg test build and enable its cedarduet subpackage."
      },
      "parameters": []
    }
  ]
}
*/

"use strict";

// Generated by scripts/build.py. This follows Operit's current official
// operit_editor debug_install_toolpkg flow, but carries the archive inline so
// phone testers do not need ADB, Android/data access, or a download URL.
const TOOLPKG_ID = "org.cedarstar.cedarduet";
const TOOLPKG_SUBPACKAGE_ID = "cedarduet";
const TOOLPKG_VERSION = "__CEDARDUET_TOOLPKG_VERSION__";
const TOOLPKG_SIZE = __CEDARDUET_TOOLPKG_SIZE__;
const TOOLPKG_SHA256 = "__CEDARDUET_TOOLPKG_SHA256__";
const TOOLPKG_ARCHIVE_BASE64 = [
__CEDARDUET_TOOLPKG_BASE64_CHUNKS__
].join("");

const EXTERNAL_PACKAGES_DIR = "/sdcard/Android/data/com.ai.assistance.operit/files/packages";
const TARGET_PATH = EXTERNAL_PACKAGES_DIR + "/org.cedarstar.cedarduet.toolpkg";
const INSTALL_ACTION = "com.ai.assistance.operit.DEBUG_INSTALL_TOOLPKG";
const INSTALL_COMPONENT =
  "com.ai.assistance.operit/.core.tools.packTool.ToolPkgDebugInstallReceiver";
const INSTALL_WAIT_MS = 5000;

function requireCurrentOperitApis() {
  if (typeof Tools === "undefined" || !Tools.Files || !Tools.System || !Tools.SoftwareSettings) {
    throw new Error("当前 Operit 未提供安装器所需的 Tools API，请升级到当前正式版");
  }
  [
    [Tools.Files, "mkdir"],
    [Tools.Files, "writeBinary"],
    [Tools.Files, "readBinary"],
    [Tools.System, "sendBroadcast"],
    [Tools.System, "sleep"],
    [Tools.System, "usePackage"],
    [Tools.SoftwareSettings, "listSandboxPackages"],
    [Tools.SoftwareSettings, "setSandboxPackageEnabled"],
  ].forEach(function (requirement) {
    if (typeof requirement[0][requirement[1]] !== "function") {
      throw new Error("当前 Operit 缺少 Tools API: " + requirement[1] + "，请升级后重试");
    }
  });
}

function findExternalPackage(snapshot, packageName) {
  const normalized = String(packageName).trim().toLowerCase();
  const packages = snapshot && Array.isArray(snapshot.packages) ? snapshot.packages : [];
  for (let index = 0; index < packages.length; index += 1) {
    const entry = packages[index] || {};
    if (String(entry.packageName || "").trim().toLowerCase() === normalized && entry.isBuiltIn !== true) {
      return entry;
    }
  }
  return null;
}

async function waitForExternalPackage(packageName, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  let snapshot = null;
  let entry = null;
  while (true) {
    snapshot = await Tools.SoftwareSettings.listSandboxPackages();
    entry = findExternalPackage(snapshot, packageName);
    if (entry || Date.now() >= deadline) return { snapshot: snapshot, entry: entry };
    await Tools.System.sleep(Math.min(300, Math.max(50, deadline - Date.now())));
  }
}

async function install_cedarduet_test() {
  try {
    requireCurrentOperitApis();

    const directoryResult = await Tools.Files.mkdir(EXTERNAL_PACKAGES_DIR, true, "android");
    if (directoryResult && directoryResult.successful === false) {
      throw new Error("无法准备 Operit 外部包目录: " + String(directoryResult.details || "unknown error"));
    }

    const writeResult = await Tools.Files.writeBinary(
      TARGET_PATH,
      TOOLPKG_ARCHIVE_BASE64,
      "android",
    );
    if (writeResult && writeResult.successful === false) {
      throw new Error("无法写入 CedarDuet ToolPkg: " + String(writeResult.details || "unknown error"));
    }

    // readBinary is part of the current official Files API. Comparing the
    // canonical Base64 verifies every archive byte without a guessed crypto API.
    const installedArchive = await Tools.Files.readBinary(TARGET_PATH, "android");
    const installedBase64 = String(installedArchive.contentBase64 || "").replace(/\s+/g, "");
    if (Number(installedArchive.size) !== TOOLPKG_SIZE || installedBase64 !== TOOLPKG_ARCHIVE_BASE64) {
      throw new Error("ToolPkg 写回校验失败，未发送安装广播");
    }

    const broadcastResult = await Tools.System.sendBroadcast({
      action: INSTALL_ACTION,
      component: INSTALL_COMPONENT,
      extras: {
        package_name: TOOLPKG_ID,
        file_path: TARGET_PATH,
        reset_subpackage_states: true,
      },
    });

    const refresh = await waitForExternalPackage(TOOLPKG_ID, INSTALL_WAIT_MS);
    if (!refresh.entry) {
      const loadErrors = refresh.snapshot && refresh.snapshot.packageLoadErrors
        ? refresh.snapshot.packageLoadErrors
        : {};
      throw new Error(
        "Operit 未在刷新后识别 CedarDuet ToolPkg；请确认使用当前正式版。加载错误: " +
          JSON.stringify(loadErrors),
      );
    }

    const enableResult = await Tools.SoftwareSettings.setSandboxPackageEnabled(
      TOOLPKG_SUBPACKAGE_ID,
      true,
    );
    const activateResult = await Tools.System.usePackage(TOOLPKG_SUBPACKAGE_ID);

    complete({
      success: true,
      message: "CedarDuet ToolPkg 测试版已安装并启用。现在可调用 cedarduet:session_login 或 cedarduet:session_register。",
      data: {
        toolpkg_id: TOOLPKG_ID,
        subpackage_id: TOOLPKG_SUBPACKAGE_ID,
        version: TOOLPKG_VERSION,
        archive_size: TOOLPKG_SIZE,
        archive_sha256: TOOLPKG_SHA256,
        archive_path: TARGET_PATH,
        broadcast_result: broadcastResult,
        package: refresh.entry,
        enable_result: enableResult,
        activate_result: activateResult,
      },
    });
  } catch (error) {
    complete({
      success: false,
      message: "CedarDuet ToolPkg 安装失败: " +
        String(error && error.message ? error.message : error),
    });
  }
}

exports.install_cedarduet_test = install_cedarduet_test;
