; Generate one random secret and put the identical value in both the existing
; [program:cedartoy] environment and this gateway program. Never commit the real
; value. One ASGI worker is sufficient for coroutine waits on this 2-core host
; and keeps the configured global concurrency cap truly global.

[program:cedartoy-duel-gateway]
command=python3 -m uvicorn duel_async_gateway:app --host 127.0.0.1 --port 8003 --workers 1
directory=/opt/cedartoy
environment=DUEL_GATEWAY_SHARED_SECRET="REPLACE_WITH_64_RANDOM_HEX",DUEL_GATEWAY_MAX_CONCURRENCY="200"
autostart=true
autorestart=true
startsecs=3
stopasgroup=true
killasgroup=true
stderr_logfile=/var/log/cedartoy-duel-gateway.err.log
stdout_logfile=/var/log/cedartoy-duel-gateway.out.log
user=root

; Add this to the existing [program:cedartoy] block as well:
; environment=DUEL_GATEWAY_SHARED_SECRET="REPLACE_WITH_THE_SAME_64_RANDOM_HEX"
