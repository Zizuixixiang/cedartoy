; Generate one random secret and put the identical value in both the existing
; [program:cedartoy] environment and this gateway program. Never commit the real
; value. One ASGI worker is sufficient for coroutine waits on this 2-core host
; and keeps the configured global concurrency cap truly global.

[program:cedartoy-duel-gateway]
command=python3 -m uvicorn duel_async_gateway:app --host 127.0.0.1 --port 8003 --workers 1
directory=/opt/cedartoy
environment=DUEL_GATEWAY_SHARED_SECRET="REPLACE_WITH_64_RANDOM_HEX",DUEL_GATEWAY_CEDARTOY_ORIGIN="http://127.0.0.1:8004",DUEL_GATEWAY_MAX_CONCURRENCY="200",DUEL_GATEWAY_MAX_WAIT_SECONDS="600",DUEL_GATEWAY_KEEPALIVE_SECONDS="12"
autostart=true
autorestart=true
startsecs=3
stopasgroup=true
killasgroup=true
stderr_logfile=/var/log/cedartoy-duel-gateway.err.log
stdout_logfile=/var/log/cedartoy-duel-gateway.out.log
user=root

; Merge these into the existing [program:cedartoy] environment (do not add a
; second environment= line):
; CEDARTOY_PORT="8004",DUEL_GATEWAY_SHARED_SECRET="REPLACE_WITH_THE_SAME_64_RANDOM_HEX",DUEL_GATEWAY_MAX_WAIT_SECONDS="600",DUEL_GATEWAY_TICKET_TTL_SECONDS="720"
