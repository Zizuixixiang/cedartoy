; Review-only example. NOT installed. No secrets belong in this file.
; The supervisor environment must already contain CHESS_PLATFORM_SECRET (64 lowercase hex),
; CHESS_ROOM_DATA=/absolute/private/autochess, CHESS_SLIM=1, CHESS_ROOM_PORT=8791,
; and PATH selecting a pinned Node >=22.13. The launcher owns the data-directory flock.
; Use a dedicated unprivileged account with read access to vendor and write access only to its data.
[program:cedartoy-autochess]
directory=/opt/cedartoy
user=cedartoy-autochess
command=/usr/bin/python3 /opt/cedartoy/scripts/run_autochess.py
autostart=false
autorestart=true
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/cedartoy-autochess.log
